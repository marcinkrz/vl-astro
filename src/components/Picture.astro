---
import { getImage, Picture as AstroPicture } from "astro:assets";
import type { ImageMetadata } from "astro";

type PictureAspect = "video" | "3/2" | "4/3" | "square" | "2/3" | "3/4";

const ASPECT_CLASS: Record<PictureAspect, string> = {
  video: "aspect-video",
  "3/2": "aspect-3/2",
  "4/3": "aspect-4/3",
  square: "aspect-square",
  "2/3": "aspect-2/3",
  "3/4": "aspect-3/4",
};

interface Props {
  src: ImageMetadata;
  alt: string;
  aspect?: PictureAspect;
  class?: string;
  imgClass?: string;
  sizes?: string;
  widths?: number[];
  loading?: "eager" | "lazy";
}

const {
  src,
  alt,
  aspect = "3/2",
  class: className,
  imgClass,
  sizes = "100vw",
  widths = [320, 480, 640, 960, 1280],
  loading = "lazy",
} = Astro.props;

const availableWidths = [...new Set(widths.filter((width) => width <= src.width))];
if (availableWidths.length === 0) availableWidths.push(src.width);

const placeholder = await getImage({
  src,
  width: 32,
  format: "webp",
  quality: 25,
});

const imageClass = [
  "picture__img absolute inset-0 h-full w-full object-cover opacity-0 transition-all duration-300 ease-out",
  imgClass,
]
  .filter(Boolean)
  .join(" ");
---

<div
  class:list={[
    "relative w-full overflow-hidden bg-(--background-1)",
    ASPECT_CLASS[aspect],
    className,
  ]}
  data-picture
>
  <span
    class="absolute inset-0 bg-cover bg-center bg-no-repeat [image-rendering:pixelated]"
    style={{ backgroundImage: `url("${placeholder.src}")` }}
    aria-hidden="true"></span>

  <AstroPicture
    src={src}
    alt={alt}
    widths={availableWidths}
    sizes={sizes}
    formats={["avif", "webp"]}
    loading={loading}
    decoding="async"
    pictureAttributes={{ class: "contents" }}
    class={imageClass}
  />

  <canvas
    class="picture__canvas pointer-events-none absolute inset-0 h-full w-full opacity-0 transition-opacity duration-300 ease-out"
    aria-hidden="true"
  ></canvas>
</div>

<script>
  const STAGES = [0.08, 0.12, 0.17, 0.23, 0.3, 0.4, 0.55, 0.7];
  const STAGE_MS = 130;
  const PIXEL_WIDTH = 160;

  const revealImage = (img: HTMLImageElement, canvas: HTMLCanvasElement) => {
    img.classList.remove("opacity-0");
    img.classList.add("opacity-100");
    canvas.classList.remove("opacity-100");
    canvas.classList.add("opacity-0");
  };

  const drawCover = (
    context: CanvasRenderingContext2D,
    img: HTMLImageElement,
    width: number,
    height: number,
  ) => {
    const sourceWidth = img.naturalWidth;
    const sourceHeight = img.naturalHeight;
    if (!sourceWidth || !sourceHeight) return false;

    const targetRatio = width / height;
    let sx = 0;
    let sy = 0;
    let cropWidth = sourceWidth;
    let cropHeight = sourceHeight;

    if (sourceWidth / sourceHeight > targetRatio) {
      cropWidth = Math.round(sourceHeight * targetRatio);
      sx = Math.round((sourceWidth - cropWidth) / 2);
    } else {
      cropHeight = Math.round(sourceWidth / targetRatio);
      sy = Math.round((sourceHeight - cropHeight) / 2);
    }

    context.drawImage(img, sx, sy, cropWidth, cropHeight, 0, 0, width, height);
    return true;
  };

  const animateReveal = (
    root: HTMLElement,
    img: HTMLImageElement,
    canvas: HTMLCanvasElement,
  ) => {
    const box = root.getBoundingClientRect();
    const width = Math.max(1, Math.round(box.width));
    const height = Math.max(1, Math.round(box.height));

    canvas.width = width;
    canvas.height = height;

    const context = canvas.getContext("2d");
    if (!context) {
      revealImage(img, canvas);
      return;
    }
    context.imageSmoothingEnabled = false;

    const source = document.createElement("canvas");
    source.width = Math.min(PIXEL_WIDTH, width);
    source.height = Math.max(1, Math.round((source.width * height) / width));

    const sourceContext = source.getContext("2d");
    if (!sourceContext || !drawCover(sourceContext, img, source.width, source.height)) {
      revealImage(img, canvas);
      return;
    }

    canvas.classList.remove("opacity-0");
    canvas.classList.add("opacity-100");

    let stage = 0;
    const runStage = () => {
      const scale = STAGES[stage];
      const stageWidth = Math.max(1, Math.round(width * scale));
      const stageHeight = Math.max(1, Math.round(height * scale));

      context.clearRect(0, 0, width, height);
      context.drawImage(source, 0, 0, stageWidth, stageHeight);
      context.drawImage(
        canvas,
        0,
        0,
        stageWidth,
        stageHeight,
        0,
        0,
        width,
        height,
      );

      stage += 1;
      if (stage < STAGES.length) {
        window.setTimeout(runStage, STAGE_MS);
      } else {
        revealImage(img, canvas);
      }
    };

    runStage();
  };

  const init = (root: HTMLElement) => {
    if (root.dataset.pictureReady === "true") return;
    root.dataset.pictureReady = "true";

    const img = root.querySelector<HTMLImageElement>(".picture__img");
    const canvas = root.querySelector<HTMLCanvasElement>(".picture__canvas");
    if (!img || !canvas) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const hasObserver = "IntersectionObserver" in window;

    let loaded = false;
    let visible = !hasObserver;
    let started = false;
    let observer: IntersectionObserver | undefined;

    const start = () => {
      if (started || !loaded) return;
      if (reducedMotion) {
        revealImage(img, canvas);
        return;
      }
      if (!visible) return;
      started = true;
      observer?.disconnect();
      animateReveal(root, img, canvas);
    };

    const markLoaded = () => {
      loaded = true;
      start();
    };

    const onLoad = () => {
      if (typeof img.decode === "function") {
        img.decode().catch(() => undefined).then(markLoaded);
      } else {
        markLoaded();
      }
    };

    if (img.complete && img.naturalWidth > 0) {
      onLoad();
    } else {
      img.addEventListener("load", onLoad, { once: true });
      img.addEventListener(
        "error",
        () => {
          observer?.disconnect();
          revealImage(img, canvas);
        },
        { once: true },
      );
    }

    if (hasObserver) {
      observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          visible = true;
          observer?.disconnect();
          start();
        },
        { threshold: 0.15 },
      );
      observer.observe(root);
    } else {
      start();
    }
  };

  const initAll = () => {
    document.querySelectorAll<HTMLElement>("[data-picture]").forEach(init);
  };

  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
