---
import { X } from "@lucide/astro";

import { getCookieTypes } from "./cookie-types";
import { getT } from "@/i18n/messages";
import Button from "../_ui/Button.astro";

const locale = Astro.currentLocale === "pl" ? "pl" : "en";
const t = getT(locale) as (
  key: string,
  vars?: Record<string, string | number>,
) => string;

const cookieTypes = getCookieTypes(t);
---

<div
  id="cookie-banner"
  class="hidden fixed z-40 bottom-2 max-sm:inset-x-2 sm:left-2 sm:w-100 p-px bg-(--background-1) rounded-2xl"
>
  <div
    class="p-3 flex gap-3 flex-col justify-between text-xs leading-snug rounded-2xl"
  >
    <p set:html={t("cookie.bannerMsg")} class="sm:text-balance" />
    <div class="max-sm:w-full flex gap-2">
      <Button id="cookie-accept-all" size="small">
        {t("cookie.accept")}
      </Button>
      <Button id="cookie-settings-button" variant="ghost" size="small">
        {t("cookie.settings")}
      </Button>
    </div>
  </div>
</div>

<div
  id="cookie-modal"
  class="fixed inset-0 z-999 modal-hidden transition-opacity duration-300 flex justify-center"
>
  <div
    id="cookie-modal-content"
    class="self-end max-sm:mb-2 sm:self-center relative overflow-hidden z-20 w-[calc(100%-1rem)] sm:max-w-lg xl:max-w-xl h-fit p-px bg-(--background-1) rounded-2xl transform translate-y-full transition-transform duration-300"
  >
    <div class="relative px-4 pt-0 flex items-center justify-between">
      <h2 class="h4 mt-4 mb-2">
        {t("cookie.modalTitle")}
      </h2>
      <button
        id="cookie-close"
        type="button"
        class="absolute right-2 p-2 text-(--muted) hover:text-(--foreground) transition-colors cursor-pointer"
      >
        <X class="w-4" />
      </button>
    </div>
    <div class="max-h-[calc(100svh-5rem)] overflow-y-auto pb-13">
      <p class="mb-4 px-4 text-xs text-(--muted)">
        {t("cookie.modalBody")}
      </p>
      <div class="px-2 lg:px-3 space-y-2">
        {
          cookieTypes.map((type) => (
            <div class="py-2 border border-(--border) rounded-lg">
              <div class="mb-2 px-3 flex items-center justify-between">
                <h3 class="font-semibold text-sm">{type.name}</h3>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input
                    class="cookie-toggle sr-only peer"
                    type="checkbox"
                    data-cookie={type.id}
                    checked={type.required}
                    disabled={type.required}
                  />
                  <div
                    class:list={[
                      "w-11 h-6 rounded-full after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-(--foreground) after:rounded-full after:h-5 after:w-5 after:transition-all",
                      type.required
                        ? "bg-(--background-2) after:bg-(--background-3)!"
                        : "bg-(--danger-border) peer-checked:bg-(--success-border)",
                    ]}
                  />
                </label>
              </div>

              <div class="py-2 mx-3 flex items-center justify-between border-t border-(--border) text-xs text-(--muted)">
                <p>{type.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div
      class="absolute bottom-0 left-0 w-full flex justify-end items-center gap-2 p-2 py-3"
    >
      <Button id="cookie-save" variant="ghost" size="small">
        {t("cookie.save")}
      </Button>
      <Button id="cookie-accept-all-modal" variant="primary" size="small">
        {t("cookie.acceptAll")}
      </Button>
    </div>
  </div>
  <div
    id="cookie-backdrop"
    class="absolute inset-0 z-10 bg-(--background) opacity-50"
  >
  </div>
</div>

<style>
  .modal-hidden {
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
  }

  .cookie-toggle:checked + div::after {
    transform: translateX(100%);
  }
</style>

<script>
  import {
    setCookieConsent,
    checkCookieConsent,
    setAnalyticsCookie,
  } from "./cookie-actions";

  let cookieController: AbortController | null = null;
  let closeTimeout: ReturnType<typeof setTimeout> | null = null;

  document.addEventListener("astro:page-load", () => {
    const MODAL_TRANSITION_MS = 300;

    const banner = document.getElementById("cookie-banner");
    const footer = document.getElementById("main-footer");
    const header = document.getElementById("main-head");
    const main = document.querySelector("main");
    const modal = document.getElementById("cookie-modal");
    const modalContent = document.getElementById("cookie-modal-content");

    const btnSettings = document.getElementById("cookie-settings-button");
    const btnAcceptAll = document.getElementById("cookie-accept-all");
    const btnAcceptAllModal = document.getElementById(
      "cookie-accept-all-modal",
    );
    const btnSave = document.getElementById("cookie-save");
    const btnClose = document.getElementById("cookie-close");
    const backdrop = document.getElementById("cookie-backdrop");

    const toggles =
      document.querySelectorAll<HTMLInputElement>(".cookie-toggle");

    if (!banner || !modal) return;

    let storedConsent: ReturnType<typeof checkCookieConsent> = null;

    try {
      storedConsent = checkCookieConsent();

      if (!storedConsent) {
        banner.classList.remove("hidden");
      } else {
        const consent = storedConsent;

        toggles.forEach((toggle) => {
          const cookieId = toggle.dataset.cookie;

          if (cookieId && !toggle.disabled) {
            toggle.checked = !!consent[cookieId as keyof typeof consent];
          }
        });
      }
    } catch (error) {
      console.error("Error loading cookie preferences:", error);
      return;
    }

    const openModal = () => {
      if (closeTimeout) {
        clearTimeout(closeTimeout);
        closeTimeout = null;
      }

      modal.classList.remove("modal-hidden");

      requestAnimationFrame(() => {
        modal.classList.remove("opacity-0");
        modalContent?.classList.remove("translate-y-full");

        banner?.classList.add("blur-sm");
        footer?.classList.add("blur-sm");
        header?.classList.add("blur-sm");
        main?.classList.add("blur-sm");
      });
    };

    const closeModal = (onClosed?: () => void) => {
      modal.classList.add("opacity-0");
      modalContent?.classList.add("translate-y-full");

      banner?.classList.remove("blur-sm");
      footer?.classList.remove("blur-sm");
      header?.classList.remove("blur-sm");
      main?.classList.remove("blur-sm");

      closeTimeout = setTimeout(() => {
        modal.classList.add("modal-hidden");
        closeTimeout = null;
        onClosed?.();
      }, MODAL_TRANSITION_MS);
    };

    const handleClose = () => closeModal();

    const applyAndReload = (preferences: Record<string, boolean>) => {
      const consent = storedConsent;

      const hasChanges =
        !consent ||
        Object.entries(preferences).some(
          ([cookieId, value]) =>
            value !== !!consent[cookieId as keyof typeof consent],
        );

      if (!hasChanges) {
        closeModal();
        return;
      }

      setCookieConsent(preferences as any);
      setAnalyticsCookie(preferences.analytics || false);
      banner.classList.add("hidden");

      closeModal(() => {
        window.location.reload();
      });
    };

    const handleAcceptAll = () => {
      const preferences: Record<string, boolean> = {};
      toggles.forEach((toggle) => {
        const cookieId = toggle.dataset.cookie;
        if (cookieId) {
          preferences[cookieId] = true;
          toggle.checked = true;
        }
      });
      applyAndReload(preferences);
    };

    const handleSave = () => {
      const preferences: Record<string, boolean> = {};
      toggles.forEach((toggle) => {
        const cookieId = toggle.dataset.cookie;
        if (cookieId) {
          preferences[cookieId] = toggle.checked;
        }
      });
      applyAndReload(preferences);
    };

    cookieController?.abort();
    cookieController = new AbortController();

    const { signal } = cookieController;

    btnSettings?.addEventListener("click", openModal, { signal });
    btnClose?.addEventListener("click", handleClose, { signal });
    backdrop?.addEventListener("click", handleClose, { signal });

    btnAcceptAll?.addEventListener("click", handleAcceptAll, { signal });
    btnAcceptAllModal?.addEventListener("click", handleAcceptAll, { signal });
    btnSave?.addEventListener("click", handleSave, { signal });

    document.addEventListener("open-cookie-settings", openModal, { signal });
  });
</script>
