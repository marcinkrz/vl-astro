---
import Button from "./_ui/Button.astro";
---

<Button
  id="overview-btn"
  variant="primary"
  size="icon"
  class="fixed bottom-[8px] left-[8px] z-[100] p-[6px]"
>
  <svg
    width="18px"
    height="18px"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    ><path
      d="M21 21L16.5143 16.5065M19 10.5C19 15.1944 15.1944 19 10.5 19C5.80558 19 2 15.1944 2 10.5C2 5.80558 5.80558 2 10.5 2C15.1944 2 19 5.80558 19 10.5Z"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>
    <path
      d="M13 10.5L10.5 10.5H8"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>
  </svg>
</Button>

<style is:global>
  html.overview {
    font-size: 50%;

    @media (width >= 48rem) {
      font-size: 45%;
    }
    @media (width >= 64rem) {
      font-size: 40%;
    }
    @media (width >= 80rem) {
      font-size: 35%;
    }
    @media (width >= 96rem) {
      font-size: 30%;
    }

    body > header {
      display: none;
    }

    body > footer {
      padding: 0;
      border-color: transparent;

      > div > span {
        display: none;
      }

      button {
        display: none;
      }

      #themeToggle {
        display: inline-flex;
        position: fixed;
        right: 8px;
        bottom: 8px;
        padding: 6px;

        svg {
          width: 18px;
          height: 18px;
        }
      }
    }
  }

  html.overview #styleguide {
    display: block;
    margin-top: 0;

    .space-y-32,
    .space-y-24 {
      :where(& > :not(:last-child)) {
        margin-bottom: 0;
        padding-bottom: 4rem;
      }
    }
    .space-y-16,
    .space-y-12 {
      :where(& > :not(:last-child)) {
        margin-bottom: 0;
        padding-bottom: 2rem;
      }
    }
    header.mb-16,
    header.mb-12 {
      margin-bottom: 2rem;
    }

    > header {
      display: none !important;
    }

    > article {
      columns: 2;
      column-gap: 1px;
      column-rule: 1px solid var(--border);
      min-height: calc(100svh - 1px);
      margin-top: 0;
      padding: 0.75rem;
      border-left: 0;

      @media (width >= 48rem) {
        columns: 3;
        padding: 1.5rem;
      }
      @media (width >= 80rem) {
        columns: 4;
      }
      @media (width >= 96rem) {
        columns: 5;
      }

      header,
      p,
      img,
      .grid {
        break-inside: avoid;
      }
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.documentElement;
    const btn = document.getElementById("overview-btn");
    if (!btn) return;

    const STORE = "__overview__";

    const set = (on: boolean) => {
      root.classList.toggle("overview", on);
      try {
        sessionStorage.setItem(STORE, on ? "1" : "0");
      } catch {}
    };

    btn.addEventListener("click", () =>
      set(!root.classList.contains("overview")),
    );

    if (!(globalThis as any).__overviewKeysBound) {
      document.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Escape" && root.classList.contains("overview"))
          set(false);
      });
      (globalThis as any).__overviewKeysBound = true;
    }

    try {
      if (sessionStorage.getItem(STORE) === "1") set(true);
    } catch {}
  })
</script>
