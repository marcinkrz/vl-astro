<button
  id="overview-btn"
  type="button"
  aria-pressed="false"
  title="Przegląd (Esc = powrót)"
  class="fixed bottom-[8px] md:bottom-[16px] left-[8px] md:left-[16px] z-[100] flex items-center gap-2 p-[8px] cursor-pointer outline-0 bg-(--foreground) text-(--background) rounded-[4px]"
>
  <svg width="24px" height="24px" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M20 20H4v-2h1v1h14V5h-1V4h2zm1-13v1h1v14H8v-1H7v2h16V7zM1 1v16h16V1zm5 15H2v-4h4zm0-5H2V7h4zm0-5H2V2h4zm5 10H7v-4h4zm0-5H7V7h4zm0-5H7V2h4zm5 10h-4v-4h4zm0-5h-4V7h4zm0-5h-4V2h4z"/><path opacity=".25" d="M6 6H2V2h4zm6 5h4V7h-4zm-5 1v4h4v-4z"/><path opacity=".5" d="M7 6V2h4v4zm-1 6H2v4h4z"/><path fill="none" d="M0 0h24v24H0z"/></svg>
</button>

<style is:global>
  html.overview {
    font-size: var(--overview-scale, 60%);

    @media (width >= 40rem) {
      font-size: var(--overview-scale, 50%);
    }
    
    @media (width >= 48rem) {
      font-size: var(--overview-scale, 40%);
    }

    body > header .logo-full,
    body > header .logo-loader {
      height: 32px;
    }

    body > header button {
      width: 48px;
      height: 48px;
    }
  }

  /* 1. Nawigacja znika — zostaje tylko <article> */
  html.overview #styleguide > header {
    display: none !important;
  }

  /* 2. Opakowujący grid → zwykły blok na pełną szerokość */
  html.overview #styleguide {
    display: block;
  }

  /* 3. Treść grupuje się w 3 (a na szerokich ekranach) 4 kolumny */
  html.overview #styleguide > article {
    columns: 2;
    column-gap: 1px;
    column-rule: 1px solid var(--border);
    margin-top: 48px;
    padding-bottom: 3rem;
    border-left: 0;

    @media (width >= 48rem) {
      columns: 3;
      margin-top: 64px;
    }
    @media (width >= 64rem) {
      columns: 4;
    }
    @media (width >= 110rem) {
      columns: 5;
    }
  }

  /* 4. Sekcje nie rozcinają się między kolumnami; czysty rytm poziomy */
  html.overview #styleguide > article > * {
    margin-bottom: 2.5rem;
  }
  html.overview #styleguide > article > section > * {
    margin-bottom: 2.5rem;
  }

  /* 5. Aktywny stan przycisku */
  #overview-btn[aria-pressed="true"] {
    font-size: 1.5rem;
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const btn = document.getElementById("overview-btn");
    if (!btn) return

    const STORE = "__overview__"

    const set = (on) => {
      root.classList.toggle("overview", on);
      btn.setAttribute("aria-pressed", String(on));
      try { sessionStorage.setItem(STORE, on ? "1" : "0") } catch {}
    }

    btn.addEventListener("click", () => set(!root.classList.contains("overview")));
    if (!window.__overviewKeys) {
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && root.classList.contains("overview")) set(false);
      })
      window.__overviewKeys = true;
    }

    try { if (sessionStorage.getItem(STORE) === "1") set(true) } catch {}
  })();
</script>