---
import { cn } from "@/utils/styles-merge";

const {
  variant = "primary",
  size = "default",
  href,
  class: className = "",
  ...props
} = Astro.props;

const base =
  "cursor-pointer inline-flex justify-center items-center tracking-wide leading-none whitespace-nowrap border border-transparent rounded-full transition-colors";

const sizes = {
  default: "h-8 px-4 text-sm",
  large: "h-10 px-6 text-base",
  small: "h-6 px-3 text-xs !leading-none",
  icon: "min-h-8 min-w-[2rem] px-1 text-sm",
} as const;

const variants = {
  primary: `bg-[var(--foreground)] text-[var(--background)] hover:bg-[var(--foreground-2)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--foreground)] active:bg-[var(--foreground-2)]`,
  secondary: `bg-[var(--primary)] text-[var(--white)] hover:bg-[var(--black)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] active:bg-[var(--black)]`,
  outline: `bg-transparent border-[var(--border-light)] text-[var(--foreground)] hover:bg-[var(--background-2)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--foreground)] active:bg-[var(--background-2)]`,
  ghost: `bg-transparent text-[var(--foreground)] hover:bg-[var(--background-2)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--foreground)] active:bg-[var(--background-2)]`,
  link: `text-inherit font-semibold min-h-auto p-0 bg-transparent text-[var(--foreground)] decoration-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--background-3)] active:underline`,
} as const;

const classes = cn(
  base,
  sizes[size as keyof typeof sizes],
  variants[variant as keyof typeof variants],
  className,
);
---

{
  href ? (
    <a class={classes} href={href} {...props}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...props}>
      <slot />
    </button>
  )
}
