---
import { Cookie } from "@lucide/astro";

import LangSwitch from "./LangSwitch.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import Button from "./_ui/Button.astro";
import { getT } from "@/i18n/messages";

const locale = Astro.currentLocale === "pl" ? "pl" : "en";
const t = getT(locale);
const year = new Date().getFullYear();
---

<footer
  class="container-full mx-auto py-4 text-(--muted) bg-(--background) border-t border-(--border)"
>
  <div class="flex justify-between items-center">
    <span class="inline-flex text-xs">
      &copy; {t("footer.copy", { year })}
    </span>
    <div class="ml-2 flex items-start gap-2">
      <LangSwitch />
      <ThemeSwitch />
      <Button
        onclick="document.dispatchEvent(new CustomEvent('open-cookie-settings'))"
        variant="ghost"
        size="icon"
        class="text-(--muted) hover:text-(--foreground) active:text-(--foreground)"
        aria-label={t("cookie.settings")}
      >
        <Cookie class="h-4" />
      </Button>
    </div>
  </div>
</footer>
