---
// Animowana ilustracja CTA. SVG jest wpisane wprost w szablon (bez importów —
// importy ?raw z public/ nie przechodzą w buildzie produkcyjnym), a animacja
// żyje w skrypcie poniżej (motion / motion.dev, wybrane przez usera).
---

<div class="w-full max-w-105 md:justify-self-end" data-studio-cta>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="520"
    height="420"
    viewBox="0 0 520 420"
    class="w-full h-auto"
    fill="none"
    aria-hidden="true"
  >
    <!-- dashed orbit: <path> zamiast <circle>, start na pozycji autorskiej kwadratu -->
    <path
      class="vlf-orbit"
      d="M 450 210 A 170 170 0 1 1 449.99 210.001"
      stroke="var(--border)"
      stroke-width="1.5"
      stroke-dasharray="2 12"></path>

    <!-- dashed inner ring -->
    <circle
      class="vlf-ring"
      cx="280"
      cy="210"
      r="118"
      stroke="var(--muted)"
      stroke-width="1.5"
      opacity=".4"
      stroke-dasharray="70 40 120 60 90 50"></circle>

    <!-- dome -->
    <path
      class="vlf-dome"
      d="M 200 330 A 80 80 0 0 1 360 330 Z"
      fill="var(--foreground)"></path>

    <!-- pulsing dot on the ring -->
    <circle class="vlf-halo" cx="280" cy="92" r="24" fill="var(--muted)"></circle>

    <!-- square riding the orbit (autorska pozycja: środek na 450,210) -->
    <rect
      class="vlf-square"
      x="428"
      y="188"
      width="44"
      height="44"
      fill="var(--foreground)"></rect>

    <!-- blinking asterisk -->
    <g class="vlf-asterisk" stroke="var(--foreground)" stroke-width="2" stroke-linecap="round">
      <path d="M 120 92 V 128"></path>
      <path d="M 102 110 H 138"></path>
      <path d="M 107 97 L 133 123"></path>
      <path d="M 133 97 L 107 123"></path>
    </g>

    <!-- spark -->
    <circle class="vlf-spark" cx="452" cy="96" r="8" fill="var(--foreground)"></circle>

    <!-- dashed arc -->
    <path
      class="vlf-arc"
      d="M 60 340 q 60 40 140 36"
      stroke="var(--muted)"
      stroke-width="1.5"></path>

    <!-- half-circle outline -->
    <path
      class="vlf-halfcircle"
      d="M 414 54 A 30 30 0 0 1 474 54"
      stroke="var(--muted)"
      stroke-width="1.5"></path>

    <!-- small dot -->
    <circle class="vlf-dotsm" cx="132" cy="300" r="5" fill="var(--foreground)"></circle>
  </svg>
</div>

<style>
  /* Bez JS (i przy prefers-reduced-motion) — pełna, statyczna grafika */
</style>

<script>
  import { animate, inView, stagger } from "motion";

  // Hoisted script nie wykonuje się ponownie po wymianie DOM przez
  // ClientRouter — inicjalizacja na astro:page-load, sprzątanie poprzedniej.
  let cleanups: Array<() => void> = [];

  function initStudioCta(): void {
    cleanups.forEach((fn) => fn());
    cleanups = [];

    const root = document.querySelector<HTMLElement>("[data-studio-cta]");
    const svg = root?.querySelector("svg");
    if (!root || !svg) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let dead = false;
    let loopsStarted = false;
    const stops: Array<{ stop: () => void }> = [];

    cleanups.push(() => {
      dead = true;
      stops.forEach((c) => c.stop());
    });

    const withOrigin = (sel: string, o = "center") => {
      const el = svg.querySelector<SVGElement>(sel);
      if (!el) return null;
      el.style.transformBox = "fill-box";
      el.style.transformOrigin = o;
      return el;
    };

    const orbit = svg.querySelector<SVGGeometryElement>(".vlf-orbit");
    const ring = withOrigin(".vlf-ring");
    const dome = withOrigin(".vlf-dome", "50% 100%");
    const halo = withOrigin(".vlf-halo");
    const square = withOrigin(".vlf-square");
    const asterisk = withOrigin(".vlf-asterisk");
    const spark = withOrigin(".vlf-spark");
    const dotsm = withOrigin(".vlf-dotsm");

    // Rysowanie konturu: solidna kreska długości ścieżki, offset L → 0
    // (Motion nie ma DrawSVG — ręczny odpowiednik stroke-dashoffset).
    const draw = (el: SVGGeometryElement, duration: number, delay = 0) => {
      const L = el.getTotalLength();
      el.style.strokeDasharray = `${L}`;
      el.style.strokeDashoffset = `${L}`;
      return animate(
        el,
        { strokeDashoffset: [L, 0] },
        { duration, delay, ease: [0.65, 0, 0.35, 1] },
      );
    };

    const startLoops = () => {
      if (dead || loopsStarted) return;
      if (!orbit || !ring || !dome || !halo || !square || !asterisk || !spark || !dotsm) return;
      loopsStarted = true;

      // orbita: dryf kreskowania, -280 = 20 pełnych okresów (2+12) — bez skoku
      stops.push(
        animate(orbit, { strokeDashoffset: -280 }, { duration: 20, ease: "linear", repeat: Infinity }),
      );

      // wewnętrzny ring: wolny obrót
      stops.push(
        animate(ring, { rotate: 360 }, { duration: 48, ease: "linear", repeat: Infinity }),
      );

      // kwadrat: rajd po orbicie — środek okręgu (280,210), r 170, a=0 → (450,210)
      stops.push(
        animate(0, 1, {
          duration: 26,
          ease: "linear",
          repeat: Infinity,
          onUpdate: (p) => {
            if (dead) return;
            const a = p * Math.PI * 2;
            square.style.transform = `translate(${170 * (Math.cos(a) - 1)}px, ${170 * Math.sin(a)}px)`;
          },
        }),
      );

      // kopuła: oddech
      stops.push(
        animate(dome, { scaleY: [1, 0.955] }, { duration: 2.4, repeat: Infinity, repeatType: "mirror", ease: "easeInOut" }),
      );

      // halo: puls
      stops.push(
        animate(halo, { scale: [1, 1.14] }, { duration: 1.8, repeat: Infinity, repeatType: "mirror", ease: "easeInOut" }),
      );

      // spark: wybuch co ~4 s
      stops.push(
        animate(
          spark,
          { scale: [0, 1.25, 0.9, 0], opacity: [0, 1, 0.6, 0] },
          { duration: 1.15, times: [0, 0.35, 0.6, 1], repeat: Infinity, repeatDelay: 2.8 },
        ),
      );

      // asterisk: mrugnięcie z obrotem
      stops.push(
        animate(
          asterisk,
          { scale: [0.5, 1, 1], opacity: [0, 1, 1], rotate: [-30, 12, 0] },
          { duration: 0.7, times: [0, 0.7, 1], repeat: Infinity, repeatDelay: 3.4 },
        ),
      );
    };

    const fire = () => {
      if (dead) return;

      // orbita: rysowanie, potem powrót do autorskiego kreskowania
      if (orbit) {
        draw(orbit, 1.6);
        setTimeout(() => {
          if (!dead) {
            orbit.style.strokeDasharray = "2 12";
            orbit.style.strokeDashoffset = "0";
          }
        }, 1700);
      }

      // ring: wjazd z zewnątrz
      if (ring) {
        stops.push(animate(ring, { scale: [0.7, 1], opacity: [0, 0.4] }, { delay: 0.5, duration: 1, ease: "easeOut" }));
      }

      // kopuła: wzniesienie
      if (dome) {
        stops.push(animate(dome, { y: [46, 0], opacity: [0, 1] }, { delay: 0.7, duration: 0.9, ease: "easeOut" }));
      }

      // kształty: pops ze sprężynowym overshootem
      const pops = [halo, square, asterisk, spark, dotsm].filter(
        (el): el is SVGElement => el !== null,
      );
      if (pops.length) {
        stops.push(
          animate(pops, { scale: [0, 1], opacity: [0, 1] }, { delay: stagger(0.12, { startDelay: 1.2 }), duration: 0.6, ease: [0.34, 1.56, 0.64, 1] }),
        );
      }

      // łuki: rysowanie
      const arc = svg.querySelector<SVGGeometryElement>(".vlf-arc");
      const half = svg.querySelector<SVGGeometryElement>(".vlf-halfcircle");
      if (arc) stops.push(draw(arc, 0.8, 2.2));
      if (half) stops.push(draw(half, 0.8, 2.35));

      // pętle startują po wejściu (~3.2 s); idempotentnie — guard w startLoops
      setTimeout(startLoops, 3200);
    };

    // jednorazowe odpalenie, gdy sekcja wjedzie w viewport
    const stopIn = inView(
      root,
      () => {
        stopIn();
        fire();
      },
      { amount: 0.25 },
    );
    cleanups.push(() => stopIn());
  }

  initStudioCta();
  document.addEventListener("astro:page-load", initStudioCta);
</script>