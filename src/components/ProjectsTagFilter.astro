---
import { X } from "@lucide/astro";
import { getT, getTagTitles } from "@/i18n/messages";

interface Props {
  tags: string[];
  ariaLabel: string;
}

const { tags, ariaLabel } = Astro.props;
const locale = Astro.currentLocale === "pl" ? "pl" : "en";
const titles = getTagTitles(locale);
const t = getT(locale);
---

{
  tags.length > 0 && (
    <div class="mb-24">
      <p class="mb-2 text-(--muted)">{t("projects.filterLabel")}</p>
      <div class="grid max-w-md grid-cols-2 gap-x-4 gap-y-2 text-xl xl:text-2xl" style={`grid-template-rows: repeat(${Math.ceil(tags.length / 2)}, 1.1em)`} role="group" aria-label={ariaLabel}>
        {tags.map((tag, index) => (
          <button
            type="button"
            data-filter-tag={tag}
            data-clear-label={`${t("projects.clearFilter")} ${titles[tag] ?? tag}`}
            aria-pressed="false"
            style={`--delay: ${index * 90}ms; view-transition-name: project-filter-${index}; view-transition-class: project-filter`}
            class="h2 inline-flex items-center gap-2 whitespace-nowrap text-left text-(--foreground) transition-colors hover:text-(--muted) active:text-(--muted) aria-pressed:text-(--muted) cursor-pointer motion-opacity-in-0 motion-translate-y-in-100 motion-delay-(--delay)"
          >
            <X data-filter-close class="hidden size-4 shrink-0 stroke-3" aria-hidden="true" />
            {titles[tag] ?? tag}
          </button>
        ))}
      </div>
    </div>
  )
}

<style is:global>
  html.filtering-projects { view-transition-name: none; }
  [data-filter-tag][hidden] { display: none; }
  [data-filter-tag][aria-pressed="true"] [data-filter-close] { display: block; }
  ::view-transition-group(.project-filter) {
    animation-duration: 400ms;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  ::view-transition-group(.project-card) {
    animation-duration: 400ms;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  ::view-transition-old(.project-card):only-child {
    animation: 200ms ease-in both project-card-exit;
  }
  ::view-transition-new(.project-card):only-child {
    animation: 300ms ease-out both project-card-enter;
  }
  @keyframes project-card-exit {
    to { opacity: 0; transform: translateY(-50px); }
  }
  @keyframes project-card-enter {
    from { opacity: 0; transform: translateY(50px); }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter-tag]")];
    const items = [...document.querySelectorAll<HTMLElement>("[data-project-tags]")];
    if (buttons.length === 0 || items.length === 0) return;

    const apply = (tag: string | null) => {
      buttons.forEach((button) => {
        const active = button.dataset.filterTag === tag;
        button.hidden = tag !== null && !active;
        button.setAttribute("aria-pressed", String(active));
        if (active) button.setAttribute("aria-label", button.dataset.clearLabel ?? "");
        else button.removeAttribute("aria-label");
      });
      items.forEach((item) => {
        const tags: string[] = JSON.parse(item.dataset.projectTags ?? "[]");
        item.hidden = tag !== null && !tags.includes(tag);
      });
    };

    let currentTransition: ViewTransition | undefined;
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const tag = button.getAttribute("aria-pressed") === "true"
          ? null
          : button.dataset.filterTag ?? null;
        if (document.startViewTransition && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("filtering-projects");
          const transition = document.startViewTransition(() => apply(tag));
          currentTransition = transition;
          const cleanup = () => {
            if (currentTransition === transition) {
              document.documentElement.classList.remove("filtering-projects");
              currentTransition = undefined;
            }
          };
          transition.finished.then(cleanup, cleanup);
        } else {
          apply(tag);
        }
        const url = new URL(location.href);
        if (tag) url.searchParams.set("tag", tag);
        else url.searchParams.delete("tag");
        history.replaceState(history.state, "", url);
      });
    });

    const param = new URLSearchParams(location.search).get("tag");
    if (buttons.some((button) => button.dataset.filterTag === param)) apply(param);
  });
</script>
