---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = "" } = Astro.props;
---

<div
  class={`absolute inset-0 overflow-hidden ${className}`}
  data-ascii-galaxy
  role="img"
  aria-label={label}
>
  <canvas class="block h-full w-full" aria-hidden="true"></canvas>
</div>

<script>
  const SLIDE_MS = 1000;
  const OMEGA = 0.55; // rad/s, clockwise; one revolution every ~11.4 s
  const FRAME_MS = 1000 / 30;
  const PALETTE = " .:+#%@";
  const cleanups = new Set<() => void>();

  type Rgb = [number, number, number];
  type Star = { r: number; theta: number; b: number };
  type FieldStar = { x: number; y: number; b: number; phase: number; speed: number };

  // Three camera setups, not three colour skins.
  const SHOTS = [
    {
      name: "wide",
      tilt: 0.08,
      pa: 0,
      zoom: 0.92,
      drift: 0.04,
      dx: 0,
      dy: 0,
      decay: 0.945,
    },
    {
      name: "oblique",
      tilt: 0.82,
      pa: -0.35,
      zoom: 1.04,
      drift: -0.03,
      dx: -0.08,
      dy: 0.05,
      decay: 0.94,
    },
    {
      name: "close",
      tilt: 0.4,
      pa: 0.28,
      zoom: 1.46,
      drift: 0.04,
      dx: 0.16,
      dy: -0.07,
      decay: 0.95,
    },
  ] as const;

  function mulberry32(seed: number) {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) >>> 0;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function buildGalaxy(count: number, seed: number) {
    const rand = mulberry32(seed);
    const stars: Star[] = [];
    const arms = Math.round(count * 0.64);
    const disk = Math.round(count * 0.2);
    const core = Math.max(0, count - arms - disk);

    for (let i = 0; i < arms; i++) {
      const arm = i % 2;
      const u = rand();
      const r = 0.12 + 0.88 * Math.pow(u, 0.9);
      // 180-degree flipped spiral. The negative log term makes the arms
      // trail behind the clockwise velocity vector instead of leading it.
      const theta =
        Math.PI +
        arm * Math.PI -
        4.5 * Math.log(r + 0.08) +
        (rand() - 0.5) * 0.18;
      const weight = arm === 0 ? 1 : 0.8;
      const b = (0.5 + 0.5 * rand()) * (1.15 - 0.35 * r) * weight;
      stars.push({ r, theta, b });
    }
    for (let i = 0; i < disk; i++) {
      const r = 0.1 + 0.9 * Math.sqrt(rand());
      stars.push({ r, theta: rand() * Math.PI * 2, b: 0.12 + 0.18 * rand() });
    }
    for (let i = 0; i < core; i++) {
      const r = 0.13 * Math.sqrt(rand());
      stars.push({ r, theta: rand() * Math.PI * 2, b: 0.75 + 0.25 * rand() });
    }

    const field: FieldStar[] = [];
    const fieldCount = Math.max(60, Math.round(count / 14));
    let guard = 0;
    while (field.length < fieldCount && guard < fieldCount * 20) {
      guard++;
      const x = rand() * 2.2 - 1.1;
      const y = rand() * 2.2 - 1.1;
      if (Math.hypot(x, y) < 0.94) continue;
      field.push({
        x,
        y,
        b: 0.2 + 0.4 * rand(),
        phase: rand() * Math.PI * 2,
        speed: 1 + Math.floor(rand() * 3),
      });
    }
    return { stars, field };
  }

  function init(root: HTMLElement) {
    if (root.dataset.ready === "true") return;
    const canvas = root.querySelector("canvas");
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    root.dataset.ready = "true";

    const probeCanvas = document.createElement("canvas");
    probeCanvas.width = 1;
    probeCanvas.height = 1;
    const probe = probeCanvas.getContext("2d", { willReadFrequently: true });

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let reduced = reduce.matches;
    let width = 0;
    let height = 0;
    let cols = 0;
    let rows = 0;
    let cellW = 0;
    let cellH = 0;
    let offX = 0;
    let offY = 0;
    let radiusPx = 1;
    let fontSize = 15;
    let primaryCss = "rgb(214, 74, 43)";
    let blackCss = "rgb(20, 20, 18)";
    let lut: string[] = [];
    let stars: Star[] = [];
    let field: FieldStar[] = [];
    let density = new Float32Array(0);
    let trail = new Float32Array(0);
    let activeShot = -1;
    let elapsed = 0;
    let last = 0;
    let lastDraw = 0;
    let raf = 0;
    let running = false;

    const cssColor = (name: string, fallback: string) => {
      const el = document.createElement("span");
      el.style.color = `var(${name})`;
      el.style.display = "none";
      root.appendChild(el);
      const value = getComputedStyle(el).color;
      el.remove();
      return value || fallback;
    };

    const toRgb = (css: string, fallback: Rgb): Rgb => {
      if (!probe) return fallback;
      probe.clearRect(0, 0, 1, 1);
      probe.fillStyle = "#000";
      probe.fillStyle = css;
      probe.fillRect(0, 0, 1, 1);
      const d = probe.getImageData(0, 0, 1, 1).data;
      return d[3] ? [d[0], d[1], d[2]] : fallback;
    };

    const rgbCss = (c: Rgb) => `rgb(${c[0]}, ${c[1]}, ${c[2]})`;

    const makeLut = (stops: readonly Rgb[]) => {
      const [a, b, c] = stops;
      const out: string[] = [];
      for (let i = 0; i < 32; i++) {
        const t = i / 31;
        const from = t < 0.5 ? a : b;
        const to = t < 0.5 ? b : c;
        const k = t < 0.5 ? t * 2 : (t - 0.5) * 2;
        out.push(rgbCss([
          Math.round(from[0] + (to[0] - from[0]) * k),
          Math.round(from[1] + (to[1] - from[1]) * k),
          Math.round(from[2] + (to[2] - from[2]) * k),
        ]));
      }
      return out;
    };

    const refreshColors = () => {
      const white = toRgb(cssColor("--white", "rgb(250,249,245)"), [250, 249, 245]);
      const black = toRgb(cssColor("--black", "rgb(20,20,18)"), [20, 20, 18]);
      const primary = toRgb(cssColor("--primary", "rgb(214,74,43)"), [214, 74, 43]);
      primaryCss = rgbCss(primary);
      blackCss = rgbCss(black);
      // Primary is the cosmos. Black arms, white core.
      lut = makeLut([primary, black, white]);
    };

    const draw = (time: number, dt = 1 / 30) => {
      if (!cols || !rows) return;
      const shot = Math.floor((time * 1000) / SLIDE_MS) % SHOTS.length;
      const cfg = SHOTS[shot];
      if (shot !== activeShot) {
        activeShot = shot;
        trail.fill(0);
      }

      const phase = time * OMEGA;
      const local = time % (SLIDE_MS / 1000);
      const zoom = cfg.zoom + cfg.drift * local;
      const rp = radiusPx * zoom;
      const ox = cfg.dx * radiusPx;
      const oy = cfg.dy * radiusPx;

      ctx.fillStyle = primaryCss;
      ctx.fillRect(0, 0, width, height);

      density.fill(0);
      const cx = cols / 2;
      const cy = rows / 2;
      const ct = Math.cos(cfg.tilt);
      const st = Math.sin(cfg.tilt);
      const cp = Math.cos(cfg.pa);
      const sp = Math.sin(cfg.pa);

      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];
        // screen y points down, so a growing angle is clockwise
        const a = s.theta + phase;
        const gx = Math.cos(a) * s.r;
        const gy = Math.sin(a) * s.r;
        const projectedY = gy * ct;
        const depth = gy * st;
        const persp = 1 / (1 + depth * 0.28);
        const sx = (gx * cp - projectedY * sp) * persp;
        const sy = (gx * sp + projectedY * cp) * persp;
        const c = Math.floor(cx + (sx * rp + ox) / cellW);
        const r = Math.floor(cy + (sy * rp + oy) / cellH);
        if (c >= 0 && c < cols && r >= 0 && r < rows) {
          const k = r * cols + c;
          density[k] = Math.min(1, density[k] + s.b * 0.22);
        }
      }
      // Sky stays put while the camera moves through the shot.
      for (let i = 0; i < field.length; i++) {
        const s = field[i];
        const tw = 0.6 + 0.4 * Math.sin(time * s.speed + s.phase);
        const c = Math.floor(cx + (s.x * radiusPx) / cellW);
        const r = Math.floor(cy + (s.y * radiusPx) / cellH);
        if (c >= 0 && c < cols && r >= 0 && r < rows) {
          const k = r * cols + c;
          density[k] = Math.max(density[k], s.b * tw * 0.6);
        }
      }

      // The arms leave a fading afterimage behind the clockwise motion.
      const decay = Math.pow(cfg.decay, dt * 30);
      for (let k = 0; k < density.length; k++) {
        trail[k] = Math.max(density[k], trail[k] * decay);
      }

      ctx.font = `700 ${fontSize}px ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace`;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const v = trail[r * cols + c];
          if (v < 0.05) continue;
          const ci = Math.min(
            PALETTE.length - 1,
            Math.round(Math.pow(v, 0.68) * (PALETTE.length - 1)),
          );
          const ch = PALETTE[ci];
          if (ch === " ") continue;
          ctx.fillStyle = lut[Math.min(31, Math.floor(v * 31))];
          ctx.fillText(ch, offX + c * cellW, offY + r * cellH);
        }
      }

      // Hard black wipe marks the camera cut; no soft transition.
      if (local < 0.08) {
        ctx.fillStyle = blackCss;
        ctx.fillRect((local / 0.08) * width, 0, 2, height);
      }
    };

    const tick = (now: number) => {
      if (!running) return;
      if (!last) last = now;
      const dt = Math.min(0.12, (now - last) / 1000);
      last = now;
      elapsed += dt;
      if (elapsed > 1e6) elapsed = 0;
      if (!lastDraw) lastDraw = now;
      if (now - lastDraw >= FRAME_MS) {
        draw(elapsed, dt);
        lastDraw = now;
      }
      raf = requestAnimationFrame(tick);
    };

    const stop = () => {
      running = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };

    const start = () => {
      if (reduced || running) return;
      running = true;
      last = 0;
      lastDraw = 0;
      raf = requestAnimationFrame(tick);
    };

    const layout = () => {
      const rect = root.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      width = rect.width;
      height = rect.height;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      fontSize = width < 480 ? 12 : 15;
      ctx.font = `700 ${fontSize}px ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace`;
      cellW = Math.max(6, ctx.measureText("M").width);
      cellH = fontSize * 1.02;
      cols = Math.max(1, Math.floor(width / cellW));
      rows = Math.max(1, Math.floor(height / cellH));
      offX = (width - cols * cellW) / 2 + cellW / 2;
      offY = (height - rows * cellH) / 2 + cellH / 2;
      radiusPx = Math.min(width, height) * 0.44;

      const count = Math.min(9000, Math.round(cols * rows * 0.9));
      const galaxy = buildGalaxy(count, 1337 + cols * 1000 + rows);
      stars = galaxy.stars;
      field = galaxy.field;
      density = new Float32Array(cols * rows);
      trail = new Float32Array(cols * rows);
      activeShot = -1;
      draw(elapsed, 1 / 30);
    };

    const ro = new ResizeObserver(layout);
    ro.observe(root);

    const onVisibility = () => {
      if (document.hidden) stop();
      else start();
    };
    document.addEventListener("visibilitychange", onVisibility);

    const onMotionChange = () => {
      reduced = reduce.matches;
      if (reduced) {
        stop();
        draw(0, 1 / 30);
      } else start();
    };
    reduce.addEventListener("change", onMotionChange);

    const themeObserver = new MutationObserver(() => {
      refreshColors();
      if (reduced) draw(elapsed, 1 / 30);
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme", "style"],
    });

    const cleanup = () => {
      stop();
      ro.disconnect();
      themeObserver.disconnect();
      reduce.removeEventListener("change", onMotionChange);
      document.removeEventListener("visibilitychange", onVisibility);
      delete root.dataset.ready;
    };
    cleanups.add(cleanup);

    refreshColors();
    layout();
    if (reduced) draw(0, 1 / 30);
    else start();
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>("[data-ascii-galaxy]").forEach(init);
  }

  document.addEventListener("astro:before-swap", () => {
    cleanups.forEach((fn) => fn());
    cleanups.clear();
  });
  document.addEventListener("astro:page-load", initAll);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll, { once: true });
  } else {
    initAll();
  }
</script>
