---
import { getT, type Locale } from "@/i18n/messages";
import { getRoute } from "@/i18n/routes";
import Button from "./_ui/Button.astro";
import Logo from "./_ui/Logo.astro";

const locale = (Astro.currentLocale === "pl" ? "pl" : "en") as Locale;
const t = getT(locale);

const pathname = Astro.url.pathname;

const items = [
  {
    key: "projects",
    href: getRoute(locale, "projects"),
    label: t("nav.projects"),
  },
  { key: "studio", href: getRoute(locale, "studio"), label: t("nav.studio") },
  {
    key: "contact",
    href: getRoute(locale, "contact"),
    label: t("nav.contact"),
  },
] as const;

const isActive = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);
---

<header class="fixed z-101 top-0 inset-x-0">
  <div
    class="relative z-2 container-full py-3 md:py-4 flex justify-between items-start"
  >
    <div class="w-full flex justify-between">
      <Logo />
      <div class="flex">
        <Button
          variant="outline"
          size="small"
          class="md:hidden"
          href={getRoute(locale, "brief")}>Brief</Button
        >
        <Button
          id="menu-toggle"
          variant="ghost"
          size="icon"
          aria-label="Menu"
          class={`md:hidden relative p-0 w-12 h-8 bg-transparent! focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white group
        `}
        >
          <span
            class={`before:block before:absolute before:w-3/4 before:h-0.5 before:bg-(--foreground)
            before:top-[2px] before:right-0
            group-[.is-active]:before:w-3/4
            group-[.is-active]:before:top-1/2
            group-[.is-active]:before:-right-5
            group-[.is-active]:before:rotate-135
            group-[.is-active]:before:-translate-1/2
            before:transition-all before:duration-400 before:ease-in-out

            after:block after:absolute after:w-3/4 after:h-0.5 after:bg-(--foreground)
            after:top-[calc(50%-1px)] after:right-0
            group-[.is-active]:after:w-3/4
            group-[.is-active]:after:top-1/2
            group-[.is-active]:after:-right-5
            group-[.is-active]:after:rotate-225
            group-[.is-active]:after:-translate-1/2
            after:transition-all after:duration-400 after:ease-in-out
          `}
          >
          </span>
          <span
            class={`
            block absolute w-3/4 h-0.5 bg-(--foreground)
            top-[calc(100%-5px)] right-0 origin-[18px_0px]
            group-[.is-active]:top-1/2
            group-[.is-active]:rotate-225
            transition-all duration-400 ease-in-out
          `}></span>
        </Button>
      </div>
    </div>
    <div class="hidden md:flex gap-x-4">
      <nav class="text-sm">
        <ul class="flex h-full items-center gap-6 font-semibold">
          {
            items.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={{
                    "text-(--muted)": isActive(item.href),
                    "text-(--foreground) hover:text-(--muted) active:text-(--muted)":
                      !isActive(item.href),
                  }}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <Button
              variant="outline"
              size="small"
              href={getRoute(locale, "brief")}>Brief</Button
            >
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <div
    id="mobile-nav"
    class={`
      group
      fixed z-1 inset-0
      flex flex-col
      transition-transition-visible duration-300
      invisible [.is-active]:visible
    `}
  >
    <nav class={`
      relative z-2 bg-(--background)
      transition-transition-all duration-300
      -translate-y-full group-[.is-active]:translate-y-0
      `}
    >
      <ul class="relative z-2 container mt-24 md:mt-32 mb-12 md:mb-16 space-y-6">
        {
          items.map((item) => (
            <li>
              <a href={item.href} class="display">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div id="mobile-nav-close" class="absolute inset-0 z-1 bg-(--background) opacity-10"></div>
  </div>
</header>
<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const toggleButton = document.getElementById("menu-toggle");
    const main = document.querySelector("main");
    const mobileNav = document.getElementById("mobile-nav");
    const mobileNavClose = document.getElementById("mobile-nav-close");

    toggleButton?.addEventListener("click", () => {
      toggleButton?.classList.toggle("is-active");
      main?.classList.toggle("blur-sm");
      mobileNav?.classList.toggle("is-active");
    });

    mobileNavClose?.addEventListener("click", () => {
      toggleButton?.classList.toggle("is-active");
      main?.classList.toggle("blur-sm");
      mobileNav?.classList.toggle("is-active");
    });
  });
</script>
