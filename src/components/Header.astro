---
import { getT, type Locale } from "@/i18n/messages";
import { getRoute } from "@/i18n/routes";
import Button from "./_ui/Button.astro";
import Logo from "./_ui/Logo.astro";

const locale = (Astro.currentLocale === "pl" ? "pl" : "en") as Locale;
const t = getT(locale);

const pathname = Astro.url.pathname;

const items = [
  {
    key: "projects",
    href: getRoute(locale, "projects"),
    label: t("nav.projects"),
  },
  { key: "studio", href: getRoute(locale, "studio"), label: t("nav.studio") },
  {
    key: "contact",
    href: getRoute(locale, "contact"),
    label: t("nav.contact"),
  },
] as const;

const isActive = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);
---

<header id="main-head" class="fixed z-101 top-0 inset-x-0">
  <div
    class="relative z-2 container-full py-3 md:py-4 flex justify-between items-center"
  >
    <Logo />
    <div class="flex gap-x-4">
      <nav class="text-sm">
        <ul class="flex h-full items-center gap-x-3 md:gap-x-6 font-semibold">
          {
            items.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={{
                    "text-(--muted)": isActive(item.href),
                    "text-(--foreground) hover:text-(--muted) active:text-(--muted)":
                      !isActive(item.href),
                  }}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <Button
              variant="outline"
              size="small"
              href={getRoute(locale, "brief")}>Brief</Button
            >
          </li>
        </ul>
      </nav>
    </div>
  </div>
  <div class="absolute inset-0 bg-linear-to-b from-(--background) from-25% to-transparent" />
</header>
