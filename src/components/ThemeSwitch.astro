---
import { Sun, Moon } from "@lucide/astro";

import Button from "./_ui/Button.astro";
import { getT } from "@/i18n/messages";

const locale = Astro.currentLocale === "pl" ? "pl" : "en";
const t = getT(locale);
const SR_LIGHT = t("footer.srLight");
const SR_DARK = t("footer.srDark");
---

<Button
  id="themeToggle"
  data-sr-light={SR_LIGHT}
  data-sr-dark={SR_DARK}
  variant="ghost"
  size="icon"
>
  <span data-icon="sun" hidden>
    <Sun class="h-4 text-(--muted) hover:text-(--foreground) active:text-(--foreground)" />
  </span>
  <span data-icon="moon">
    <Moon class="h-4 text-(--muted) hover:text-(--foreground) active:text-(--foreground)" />
  </span>
</Button>

<script is:inline>
  function initTheme() {
    const html = document.documentElement;
    const button = document.getElementById("themeToggle");
    const themeMatcher = window.matchMedia("(prefers-color-scheme: dark)");

    const getStoredTheme = () => localStorage.getItem("theme") || "system";

    const applyTheme = (theme) => {
      const resolvedTheme =
        theme === "system" ? (themeMatcher.matches ? "dark" : "light") : theme;

      html.setAttribute("data-theme", resolvedTheme);
      html.style.colorScheme = resolvedTheme;

      if (button) {
        const isDark = resolvedTheme === "dark";
        const sunIcon = button.querySelector('[data-icon="sun"]');
        const moonIcon = button.querySelector('[data-icon="moon"]');

        if (sunIcon && moonIcon) {
          sunIcon.hidden = !isDark;
          moonIcon.hidden = isDark;
        }

        const label = isDark ? button.dataset.srLight : button.dataset.srDark;
        button.setAttribute("aria-label", label);
        button.setAttribute("title", label);
      }
    };

    themeMatcher.onchange = () => {
      if (getStoredTheme() === "system") applyTheme("system");
    };

    if (button && !button.dataset.bound) {
      button.dataset.bound = "true";
      button.addEventListener("click", () => {
        const current = html.getAttribute("data-theme");
        const next = current === "dark" ? "light" : "dark";

        localStorage.setItem("theme", next);
        applyTheme(next);
      });
    }

    applyTheme(getStoredTheme());
  }

  initTheme();

  document.addEventListener("astro:after-swap", initTheme);
</script>
