---
import Button from "@/components/_ui/Button.astro";
import Section from "@/layouts/styleguide/Section.astro";

const {
  logo_title,
  logo_lead,
  btn_text,
  logo_wordmark_title,
  logo_wordmark_lead,
  logo_mark_title,
  logo_mark_lead,
  logo_color_title,
  logo_color_lead,
} = Astro.props;
