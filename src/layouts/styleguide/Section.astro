---
const { id, title, lead } = Astro.props;
---

<section
  id={id}
  class="scroll-mt-12 md:scroll-mt-16 px-2 md:px-4 lg:px-6 border-t border-(--border)"
>
  <header
    class="max-w-340 mx-auto py-4 md:py-6 lg:py-8 md:grid grid-cols-2 gap-2 md:gap-4 lg:gap-6"
  >
    <h3 class="h3 mb-4">{title}</h3>
    <p class="font-semibold">{lead}</p>
  </header>
  <div class="max-w-340 mx-auto mt-12 md:mt-16">
    <slot />
  </div>
</section>
