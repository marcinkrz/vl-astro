---
import Section from "@/layouts/styleguide/Section.astro";
// import ColorPalette from "@/layouts/styleguide/ColorPalette.astro";

const {
  color_title,
  color_lead,
  color_brand_title,
  color_brand_lead,
  color_palette_title,
  color_palette_lead,
} = Astro.props;
---

<section
  id="color"
  class="scroll-mt-12 md:scroll-mt-16 space-y-24 md:space-y-32"
>
  <header class="md:border-t border-(--border)">
    <div
      class="relative pt-[50%] md:pt-[25%] px-2 md:px-4 lg:px-6 bg-(--background-1) text-(--foreground)"
    >
      <div class="max-w-340 mx-auto">
        <h2 class="display pb-2 md:pb-4 lg:pb-6 md:grid grid-cols-2">
          {color_title}
        </h2>
      </div>
    </div>
    <div class="px-2 md:px-4 lg:px-6">
      <div class="max-w-340 mx-auto">
        <p class="h3 mt-4 mb-8">{color_lead}</p>
      </div>
    </div>
  </header>
  <Section id="color-brand" title={color_brand_title} lead={color_brand_lead}>
    <div class="space-y-2 md:space-y-4 lg:space-y-6">
      <div class="grid grid-cols-3 gap-2 md:gap-4 lg:gap-6">
        <div
          class="relative aspect-square lg:aspect-video bg-(--black) border border-(--border)"
        >
          <div class="absolute inset-0 p-2 md:p-4 lg:p-6 flex items-end">
            <p class="text-xs lg:text-sm text-(--white)">
              --black<br />cmyk(0% 0% 31% 94%)<br />oklch(0.17 0.01 107)<br
              />#10100b
            </p>
          </div>
        </div>
        <div
          class="relative aspect-square lg:aspect-video bg-(--white) border border-(--border)"
        >
          <div class="absolute inset-0 p-2 md:p-4 lg:p-6 flex items-end">
            <p class="text-xs md:text-sm text-(--black)">
              --white<br />cmyk(0% 0% 3% 2%)<br />oklch(0.98 0.01 107)<br
              />#f9f9f1
            </p>
          </div>
        </div>
        <div></div>
        <div class="relative aspect-square lg:aspect-video bg-(--primary)">
          <div class="absolute inset-0 p-2 md:p-4 lg:p-6 flex items-end">
            <p class="text-xs lg:text-sm text-(--white)">--primary</p>
          </div>
        </div>
        <div class="relative aspect-square lg:aspect-video bg-(--accent-1)">
          <div class="absolute inset-0 p-2 md:p-4 lg:p-6 flex items-end">
            <p class="text-xs lg:text-sm text-(--white)">--accent-1</p>
          </div>
        </div>
        <div class="relative aspect-square lg:aspect-video bg-(--accent-2)">
          <div class="absolute inset-0 p-2 md:p-4 lg:p-6 flex items-end">
            <p class="text-xs lg:text-sm text-(--white)">--accent-2</p>
          </div>
        </div>
      </div>
    </div>
  </Section>
  <Section
    id="color-palette"
    title={color_palette_title}
    lead={color_palette_lead}
  >
    <div class="space-y-2 md:space-y-4">
      <div
        class="grid grid-cols-9 mb-4 md:mb-6 lg:mb-8 border border-(--border)"
      >
        <div class="aspect-square bg-(--black)"></div>
        <div class="aspect-square bg-(--primary-darkest)"></div>
        <div class="aspect-square bg-(--primary-darker)"></div>
        <div class="aspect-square bg-(--primary-dark)"></div>
        <div class="aspect-square bg-(--primary)"></div>
        <div class="aspect-square bg-(--primary-light)"></div>
        <div class="aspect-square bg-(--primary-lighter)"></div>
        <div class="aspect-square bg-(--primary-lightest)"></div>
        <div class="aspect-square bg-(--white)"></div>
      </div>
      <div
        class="grid grid-cols-9 mb-4 md:mb-6 lg:mb-8 border border-(--border)"
      >
        <div class="aspect-square bg-(--black)"></div>
        <div class="aspect-square bg-(--accent-1-darkest)"></div>
        <div class="aspect-square bg-(--accent-1-darker)"></div>
        <div class="aspect-square bg-(--accent-1-dark)"></div>
        <div class="aspect-square bg-(--accent-1)"></div>
        <div class="aspect-square bg-(--accent-1-light)"></div>
        <div class="aspect-square bg-(--accent-1-lighter)"></div>
        <div class="aspect-square bg-(--accent-1-lightest)"></div>
        <div class="aspect-square bg-(--white)"></div>
      </div>
      <div
        class="grid grid-cols-9 mb-4 md:mb-6 lg:mb-8 border border-(--border)"
      >
        <div class="aspect-square bg-(--black)"></div>
        <div class="aspect-square bg-(--accent-2-darkest)"></div>
        <div class="aspect-square bg-(--accent-2-darker)"></div>
        <div class="aspect-square bg-(--accent-2-dark)"></div>
        <div class="aspect-square bg-(--accent-2)"></div>
        <div class="aspect-square bg-(--accent-2-light)"></div>
        <div class="aspect-square bg-(--accent-2-lighter)"></div>
        <div class="aspect-square bg-(--accent-2-lightest)"></div>
        <div class="aspect-square bg-(--white)"></div>
      </div>
      <!-- <ColorPalette /> -->
    </div>
  </Section>
</section>
