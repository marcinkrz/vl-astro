---
import Button from "@/components/_ui/Button.astro";
import Section from "@/layouts/styleguide/Section.astro";

const {
  typography_title,
  typography_lead,
  btn_text,
  typeface_title,
  typeface_lead,
  typeface_heading,
  typeface_subheading,
  typeface_copy,
  sizes_title,
  sizes_lead,
  sizes_pangram
} = Astro.props;
---

<section
  id="typography"
  class="scroll-mt-12 md:scroll-mt-16 space-y-24 md:space-y-32"
>
  <header class="md:border-t border-(--border)">
    <div
      class="relative pt-[50%] md:pt-[25%] px-2 md:px-4 lg:px-6 bg-(--background-1) text-(--foreground)"
    >
      <div class="max-w-340 mx-auto">
        <h2 class="display pb-2 md:pb-4 lg:pb-6 md:grid grid-cols-2">
          {typography_title}
        </h2>
      </div>
    </div>
    <div class="px-2 md:px-4 lg:px-6">
      <div class="max-w-340 mx-auto">
        <p class="h3 mt-4 mb-8">{typography_lead}</p>
        <Button variant="primary" size="large">{btn_text}</Button>
      </div>
    </div>
  </header>
  <Section id="typography-typeface" title={typeface_title} lead={typeface_lead}>
    <div class="pt-1 grid grid-cols-4 2xl:grid-cols-5 border-t border-(--border)">
      <div class="text-xs md:text-sm">
        <p class="font-semibold">.display</p>
        <p class="text-(--muted)">Inter 600<br/>36px-72px</p>
      </div>
      <p class="col-span-3 mb-6 display">{typeface_heading}</p>
    </div>

    <div class="pt-1 grid grid-cols-4 2xl:grid-cols-5 border-t border-(--border)">
      <div class="text-xs md:text-sm">
        <p class="font-semibold">.h3</p>
        <p class="text-(--muted)">Inter 600<br/>20px-24px</p>
      </div>
      <p class="col-span-3 h3 mb-12">{typeface_subheading}</p>
    </div>

    <div class="pt-1 grid grid-cols-4 2xl:grid-cols-5 border-t border-(--border)">
      <div class="text-xs md:text-sm">
        <p class="font-semibold">body</p>
        <p class="text-(--muted)">Inter 400<br/>16px</p>
      </div>
      <p class="col-span-3">{typeface_copy}</p>
    </div>
  </Section>
  <Section id="typography-sizes" title={sizes_title} lead={sizes_lead}>
    <div class="space-y-12">
      <div class="pt-1 lg:grid grid-cols-4 2xl:grid-cols-5 border-t border-(--border)">
        <p class="max-lg:mb-2 flex lg:flex-col text-xs md:text-sm">
          <span class="mr-2 font-semibold">.display</span>
          <span class="text-(--muted)">Inter 600, 36px-72px</span>
        </p>
        <p class="md:col-span-3 2xl:col-span-4 display">{sizes_pangram}</p>
      </div>
      <div class="pt-1 lg:grid grid-cols-4 2xl:grid-cols-5 border-t border-(--border)">
        <p class="max-lg:mb-2 flex lg:flex-col text-xs md:text-sm">
          <span class="mr-2 font-semibold">.h1</span>
          <span class="text-(--muted)">Inter 600, 30px-48px</span>
        </p>
        <p class="md:col-span-3 2xl:col-span-4 h1">{sizes_pangram}</p>
      </div>
      <div class="pt-1 lg:grid grid-cols-4 2xl:grid-cols-5 border-t border-(--border)">
        <p class="max-lg:mb-2 flex lg:flex-col text-xs md:text-sm">
          <span class="mr-2 font-semibold">.h2</span>
          <span class="text-(--muted)">Inter 600, 24px-30px</span>
        </p>
        <p class="md:col-span-3 2xl:col-span-4 h2">{sizes_pangram}</p>
      </div>
      <div class="pt-1 lg:grid grid-cols-4 2xl:grid-cols-5 border-t border-(--border)">
        <p class="max-lg:mb-2 flex lg:flex-col text-xs md:text-sm">
          <span class="mr-2 font-semibold">.h3</span>
          <span class="text-(--muted)">Inter 600, 20px-24px</span>
        </p>
        <p class="md:col-span-3 2xl:col-span-4 h3">{sizes_pangram}</p>
      </div>
    </div>
  </Section>
</section>
