---
interface Props {
  title?: string;
  description?: string;
}

import { getT, type Locale } from "@/i18n/messages";
const locale = (Astro.currentLocale === "pl" ? "pl" : "en") as Locale;
const t = getT(locale);

import Button from "@/components/_ui/Button.astro";
import Input from "@/components/_ui/Input.astro";
import { ArrowUpRight, Clock5, Undo2 } from "@lucide/astro";

const messages = {
  locale,
  errors: {
    required: t("brief-form.errors.required"),
    email: t("brief-form.errors.email"),
    phone: t("brief-form.errors.phone"),
    nip: t("brief-form.errors.nip"),
    website: t("brief-form.errors.website"),
    message: t("brief-form.errors.message"),
    services: t("brief-form.errors.services"),
    budget: t("brief-form.errors.budget"),
    sendFailed: t("brief-form.errors.send-failed"),
    network: t("brief-form.errors.network"),
  },
  sending: t("brief-form.state.sending"),
  sent: t("brief-form.state.sent"),
};
