                  class={`
                  pointer-events-none
                  absolute left-2 top-5 -translate-y-1/2
                  px-[0.5ch]
                  bg-(--background)
                  text-(--muted)
                  transition-all duration-150
                  peer-focus:top-0
                  peer-focus:-translate-y-1/2
                  peer-focus:text-sm
                  peer-not-placeholder-shown:top-0
                  peer-not-placeholder-shown:-translate-y-1/2
                  peer-not-placeholder-shown:text-sm
                `}
                >
                  {t("contact-form.nip")}
                </span>
              </label>
              <p id="nip-error" class="field-error mt-1" hidden></p>
            </div>
          </div>
          <div class="flex gap-2 md:gap-4">
            <Button href="#site" data-go="site" variant="ghost" size="large">
              {t("brief-form.prev")}
            </Button>
            <Button type="submit" id="brief-submit" size="large" class="w-full">
              {t("contact-form.submit")}
              <ArrowUpRight class="h-4" />
            </Button>
          </div>
        </div>
      </section>
      <div
        id="response-message"
        class="group inline-flex rounded-md text-sm"
        aria-live="polite"
      >
        <p class={`
          px-3 py-2
          group-[.pending]:bg-(--background-1)
          group-[.error]:bg-(--danger-bg) group-[.error]:text-(--danger-text)
          group-[.success]:bg-(--success-bg) group-[.success]:text-(--success-text)
        `}></p>
      </div>
    </div>
  </div>
</form>
<div
  class="w-full h-1 bg-(--background-1)"
  aria-hidden="true"
>
  <div
    id="brief-progress-bar"
    class="h-full w-0 bg-(--foreground) transition-all duration-500"
  >
  </div>
</div>

<script>
  let globalCleanups: Array<() => void> = [];

  type BriefI18n = {
    locale: string;
    errors: Record<string, string>;
    sending?: string;
    sent?: string;
  };

  function initBrief(): void {
    const form = document.getElementById(
      "brief-form",
    ) as HTMLFormElement | null;

    if (!form) {
      // Wyszliśmy z /brief (np. /contact) — zdejmij globalne listenery.
      globalCleanups.forEach((fn) => fn());
      globalCleanups = [];
      return;
    }
    if (form.dataset.briefInitialized === "1") return;
    form.dataset.briefInitialized = "1";

    globalCleanups.forEach((fn) => fn());
    globalCleanups = [];

    // FIX: żaden przycisk poza właściwym submit-em nie wysyła formularza
    // (klik w padding Buttona wokół kotwicy = niejawny submit → skok do brief).
    form.querySelectorAll("button").forEach((b) => {
      if (b.id !== "brief-submit") b.setAttribute("type", "button");
    });

    // ---------- i18n z <script type="application/json"> ----------
    let i18n: BriefI18n = { locale: "en", errors: {} };
    const i18nEl = document.getElementById("brief-i18n");
    if (i18nEl?.textContent) {
      try {
        i18n = {
          ...i18n,
          ...(JSON.parse(i18nEl.textContent) as Partial<BriefI18n>),
        };
      } catch {
        i18n = { locale: "en", errors: {} };
      }
    }
    const msg: Record<string, string> = i18n.errors;

    // ---------- Nawigacja ekranowa ----------
    const screens: HTMLElement[] = Array.from(
      form.querySelectorAll<HTMLElement>("section.screen"),
    );
    const order: string[] = screens.map((s) => s.id);
    let current = 0;
    const reduceMotion: boolean = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const progressBar = document.getElementById("brief-progress-bar");

    const updateProgress = (): void => {
      if (progressBar) {
        progressBar.style.width = `${(current / screens.length) * 100}%`;
      }
    };

    interface ShowOptions {
      updateHash?: boolean;
      focusHeading?: boolean;
    }

    function show(target: string | number, opts: ShowOptions = {}): void {
      const index = typeof target === "number" ? target : order.indexOf(target);
      if (index < 0 || index >= screens.length) return;
      const next = screens[index]!;
      const prev = screens[current];
      // FIX: current aktualizowany SYNCHRONICZNIE — callback View Transition jest
      // odroczony, więc pasek postępu i walidacja muszą czytać stan już teraz.
      current = index;

      const apply = (): void => {
        if (prev && prev !== next) prev.classList.remove("is-active");
        next.classList.add("is-active");
      };

      if (!reduceMotion && document.startViewTransition) {
        document.startViewTransition(apply);
      } else {
        apply();
      }

      window.scrollTo({ top: 0, behavior: "instant" });
      if (opts.updateHash !== false) {
        history.replaceState(null, "", `#${next.id}`);
      }
      updateProgress();

      if (opts.focusHeading !== false) {
        const h = next.querySelector("h2");
        if (h) {
          h.setAttribute("tabindex", "-1");
          h.focus({ preventScroll: true });
        }
      }
    }

    // ---------- Walidacja ----------
    const NIP_WEIGHTS: number[] = [6, 5, 7, 2, 3, 4, 5, 6, 7];

    function isValidNip(value: string): boolean {
      const nip = value.replace(/[\s-]/g, "");
      if (!/^\d{10}$/.test(nip)) return false;
      let sum = 0;
      for (let i = 0; i < 9; i++) sum += NIP_WEIGHTS[i]! * Number(nip[i]);
      return sum % 11 === Number(nip[9]);
    }

    function isValidEmail(value: string): boolean {
      return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value) && value.length <= 254;
    }

    function isValidPhone(value: string): boolean {
      const compact = value.replace(/[\s\-().]/g, "");
      if (compact.length < 7 || compact.length > 20) return false;
      if (/^(\+48|0048)?\d{9}$/.test(compact)) return true; // PL: komórkowy i stacjonarny
      if (/^\+\d{7,15}$/.test(compact)) return true; // +kod kraju + numer
      if (/^00\d{8,15}$/.test(compact)) return true; // prefiks międzynarodowy 00
      if (/^0\d{9,14}$/.test(compact)) return true; // 0 + numer (stacjonarny z „0")
      return false;
    }

    function isValidWebsite(value: string): boolean {
      return /^(https?:\/\/)?([a-z0-9-]+\.)+[a-z]{2,}(:\d{2,5})?(\/\S*)?$/i.test(
        value,
      );
    }

    interface FieldDef {
      name: string;
      screen: string;
      check: (v: string) => boolean;
      error: string;
      optional?: boolean;
    }

    // FIX: ekran „website" nazywa się teraz „site" (sekcja), pole zostaje
    // name/id „website" — brak kolizji id, walidacja czyta INPUT.
    const fields: FieldDef[] = [
      {
        name: "message",
        screen: "brief",
        check: (v) => v.trim().length > 0,
        error: msg.message ?? "",
      },
      {
        name: "website",
        screen: "site",
        check: isValidWebsite,
        error: msg.website ?? "",
        optional: true,
      },
      {
        name: "firstName",
        screen: "last",
        check: (v) => v.trim().length >= 2,
        error: msg.required ?? "",
      },
      {
        name: "phone",
        screen: "last",
        check: isValidPhone,
        error: msg.phone ?? "",
      },
      {
        name: "email",
        screen: "last",
        check: isValidEmail,
        error: msg.email ?? "",
      },
      {
        name: "nip",
        screen: "last",
        check: isValidNip,
        error: msg.nip ?? "",
        optional: true,
      },
    ];

    function fieldInput(name: string): HTMLInputElement | null {
      return document.getElementById(name) as HTMLInputElement | null;
    }

    function setError(name: string, text: string | null): void {
      const input = fieldInput(name);
      const el = document.getElementById(`${name}-error`);
      if (!input || !el) return;
      if (text) {
        el.textContent = text;
        el.hidden = false;
        input.classList.add("field-invalid");
        input.setAttribute("aria-invalid", "true");
      } else {
        el.hidden = true;
        input.classList.remove("field-invalid");
        input.removeAttribute("aria-invalid");
      }
    }

    function validateField(name: string): boolean {
      const def = fields.find((f) => f.name === name);
      const input = fieldInput(name);
      if (!def || !input) return true;
      const value = input.value || "";
      if (def.optional && !value.trim()) {
        setError(name, null);
        return true;
      }
      const valid = def.check(value);
      setError(name, valid ? null : def.error);
      return valid;
    }

    function setGroupError(id: string, text: string | null): void {
      const el = document.getElementById(id);
      if (!el) return;
      if (text) {
        el.textContent = text;
        el.hidden = false;
      } else {
        el.hidden = true;
      }
    }

    function resetErrors(): void {
      fields.forEach((f) => setError(f.name, null));
      setGroupError("services-error", null);
      setGroupError("budget-error", null);
    }

    // Walidacja całego ekranu (pola + grupy) — wywoływana przy „Dalej".
    function validateScreen(screenId: string): boolean {
      let ok = true;
      let firstInvalid: HTMLInputElement | null = null;

      for (const f of fields) {
        if (f.screen !== screenId) continue;
        if (!validateField(f.name)) {
          ok = false;
          const input = fieldInput(f.name);
          if (input && !firstInvalid) firstInvalid = input;
        }
      }

      if (screenId === "services") {
        const otherChecked = !!otherCheckbox?.checked;
        const otherValue = otherInput?.value.trim() ?? "";
        if (otherChecked && !otherValue) {
          ok = false;
          otherInput?.classList.add("field-invalid");
          if (!firstInvalid && otherInput) firstInvalid = otherInput;
          setGroupError("services-error", msg.otherService ?? "");
        } else {
          const any = !!form!.querySelector<HTMLInputElement>(
            'input[name="services"]:checked',
          );
          setGroupError("services-error", any ? null : (msg.services ?? ""));
          if (!any) {
            ok = false;
            if (!firstInvalid)
              form!
                .querySelector<HTMLInputElement>('input[name="services"]')
                ?.focus();
          }
        }
      }
      if (screenId === "budget") {
        const any = !!form!.querySelector<HTMLInputElement>(
          'input[name="budget"]:checked',
        );
        setGroupError("budget-error", any ? null : (msg.budget ?? ""));
        if (!any) {
          ok = false;
          if (!firstInvalid)
            form!
              .querySelector<HTMLInputElement>('input[name="budget"]')
              ?.focus();
        }
      }

      if (!ok && firstInvalid) firstInvalid.focus();
      return ok;
    }

    // Walidacja „w locie": na blur i przy poprawianiu
    fields.forEach((f) => {
      const input = fieldInput(f.name);
      if (!input) return;
      input.addEventListener("blur", () => validateField(f.name));
      input.addEventListener("input", () => {
        if (input.classList.contains("field-invalid")) validateField(f.name);
      });
    });

    // ---------- Opcja F: „Inny" — klik = pole tekstowe ----------
    const otherCheckbox = document.getElementById(
      "other-service",
    ) as HTMLInputElement | null;
    const otherInput = document.getElementById(
      "other-service-value",
    ) as HTMLInputElement | null;
    const otherLabel = document.getElementById("other-service-label");

    function syncOther(open: boolean): void {
      if (!otherCheckbox || !otherInput || !otherLabel) return;
      otherLabel.classList.toggle("hidden", open);
      otherInput.classList.toggle("hidden", !open);
      if (open) {
        otherInput.focus();
      } else {
        otherInput.value = "";
        otherCheckbox.value = "other";
        otherInput.classList.remove("field-invalid");
      }
    }

    if (otherCheckbox) {
      otherCheckbox.addEventListener("change", () =>
        syncOther(otherCheckbox.checked),
      );
    }
    if (otherInput) {
      otherInput.addEventListener("input", () => {
        if (otherCheckbox)
          otherCheckbox.value = otherInput.value.trim() || "other";
        if (
          otherInput.classList.contains("field-invalid") &&
          otherInput.value.trim() !== ""
        ) {
          otherInput.classList.remove("field-invalid");
          const anyChecked = !!form.querySelector<HTMLInputElement>(
            'input[name="services"]:checked',
          );
          setGroupError(
            "services-error",
            anyChecked ? null : (msg.services ?? ""),
          );
        }
      });
    }

    // ---------- Nawigacja ----------
    // „Dalej" waliduje bieżący ekran, „Wstecz" zawsze przepuszcza.
    function tryGo(targetId: string): void {
      const targetIndex = order.indexOf(targetId);
      if (targetIndex === -1) return;
      const currentId = screens[current]?.id ?? "";
      if (targetIndex > current && !validateScreen(currentId)) return;
      show(targetId);
    }

    form.addEventListener("click", (e) => {
      const go = (e.target as Element).closest("[data-go]");
      if (!go) return;
      e.preventDefault();
      tryGo(go.getAttribute("data-go") ?? "");
    });

    // FIX: Enter na ekranach pośrednich = „Dalej" (z walidacją), nie wysyłka;
    // na ekranie „last" Enter pozwala na natywny submit.
    form.addEventListener("keydown", (e) => {
      if (e.key !== "Enter") return;
      const el = e.target as HTMLElement;
      const tag = el.tagName;
      if (
        tag === "TEXTAREA" ||
        tag === "BUTTON" ||
        tag === "A" ||
        el.isContentEditable
      )
        return;
      if (screens[current]?.id !== "last") {
        e.preventDefault();
        const nextId = order[current + 1] ?? "";
        if (nextId) tryGo(nextId);
      }
    });

    // Klawiatura: strzałki / PageUp-Down — nawigacja pomocnicza (bez blokowania).
    const onKeydown = (e: KeyboardEvent): void => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      const tag = (e.target as HTMLElement).tagName;
      if (
        tag === "INPUT" ||
        tag === "TEXTAREA" ||
        tag === "SELECT" ||
        (e.target as HTMLElement).isContentEditable
      ) {
        return;
      }
      if (e.key === "ArrowDown" || e.key === "PageDown") {
        e.preventDefault();
        show(Math.min(current + 1, screens.length - 1));
      } else if (e.key === "ArrowUp" || e.key === "PageUp") {
        e.preventDefault();
        show(Math.max(current - 1, 0));
      }
    };

    const onHashchange = (): void => {
      show(location.hash.slice(1), { updateHash: false });
    };

    document.addEventListener("keydown", onKeydown);
    window.addEventListener("hashchange", onHashchange);
    globalCleanups.push(() =>
      document.removeEventListener("keydown", onKeydown),
    );
    globalCleanups.push(() =>
      window.removeEventListener("hashchange", onHashchange),
    );

    // Wejście z hashem w URL / start od pierwszego ekranu
    if (location.hash) {
      show(location.hash.slice(1), { updateHash: false, focusHeading: false });
    } else {
      show(0, { updateHash: false, focusHeading: false });
    }

    // ---------- Wysyłka ----------
    const responseBox = document.getElementById("response-message");
    const responseText = responseBox?.querySelector("p") ?? null;
    let submitting = false;

    function showResponse(
      kind: "error" | "pending" | "success",
      text: string,
    ): void {
      if (!responseBox || !responseText) return;
      responseBox.classList.remove("error", "pending", "success");
      responseBox.classList.add(kind);
      responseText.textContent = text;
    }

    interface ApiResponse {
      ok?: boolean;
      id?: string | null;
      errors?: Record<string, string>;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (submitting) return;

      const anyService = !!form.querySelector<HTMLInputElement>(
        'input[name="services"]:checked',
      );
      const otherEmpty =
        !!otherCheckbox?.checked &&
        (!otherInput || otherInput.value.trim() === "");
      const anyBudget = !!form.querySelector<HTMLInputElement>(
        'input[name="budget"]:checked',
      );
      setGroupError(
        "services-error",
        !anyService
          ? (msg.services ?? "")
          : otherEmpty
            ? (msg.otherService ?? "")
            : null,
      );
      if (otherEmpty) otherInput?.classList.add("field-invalid");
      setGroupError("budget-error", anyBudget ? null : (msg.budget ?? ""));

      let jumpTo: string | null = null;
      if (!anyService || otherEmpty) jumpTo = "services";
      else if (!anyBudget) jumpTo = "budget";

      let firstBadField: FieldDef | null = null;
      for (const f of fields) {
        if (!validateField(f.name) && !firstBadField) firstBadField = f;
      }
      if (!jumpTo && firstBadField) jumpTo = firstBadField.screen;

      if (jumpTo) {
        show(jumpTo);
        if (jumpTo === "services") {
          if (otherEmpty) otherInput?.focus();
          else
            form
              .querySelector<HTMLInputElement>('input[name="services"]')
              ?.focus();
        } else if (jumpTo === "budget") {
          form
            .querySelector<HTMLInputElement>('input[name="budget"]')
            ?.focus();
        } else if (firstBadField) {
          fieldInput(firstBadField.name)?.focus();
        }
        return;
      }

      const submitBtn = document.getElementById(
        "brief-submit",
      ) as HTMLButtonElement | null;
      submitting = true;
      if (submitBtn) submitBtn.disabled = true;
      showResponse("pending", i18n.sending ?? "");

      try {
        const res = await fetch("/api/brief", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
          signal: AbortSignal.timeout(20000),
        });
        const data = (await res.json().catch(() => ({}))) as ApiResponse;

        if (res.ok && data.ok) {
          showResponse("success", i18n.sent ?? "");
          form.reset();
          syncOther(false);
          resetErrors();
        } else {
          const errors = data.errors ?? {};
          let jumped = false;
          Object.keys(errors).forEach((name) => {
            if (name === "_form") return;
            const def = fields.find((f) => f.name === name);
            if (def) {
              setError(name, errors[name] ?? "");
              if (!jumped) {
                show(def.screen);
                jumped = true;
              }
            }
          });
          showResponse(
            "error",
            errors["_form"] ?? msg.sendFailed ?? "Błąd wysyłki.",
          );
          if (!jumped) show("last");
        }
      } catch {
        showResponse("error", msg.network ?? msg.sendFailed ?? "Błąd sieci.");
      } finally {
        submitting = false;
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }

  // Pierwsze ładowanie…
  initBrief();
  // …i każda nawigacja kliencka Astro (ClientRouter podmienia DOM).
  document.addEventListener("astro:page-load", initBrief);
</script>
