</noscript>

<style>
  /* ---------- Ekrany + przejścia ---------- */
  .screen {
    display: none;
  }
  .screen.is-active {
    display: flex;
    animation: screen-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes screen-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .screen h2:focus {
    outline: none;
  }

  /* Animacja ekranu wychodzącego — View Transitions API */
  ::view-transition-old(root) {
    animation: 0.25s cubic-bezier(0.4, 0, 0.2, 1) both vt-out;
  }
  ::view-transition-new(root) {
    animation: 0.3s cubic-bezier(0.22, 1, 0.36, 1) both vt-in;
  }
  @keyframes vt-out {
    to {
      opacity: 0;
      transform: translateY(-14px);
    }
  }
  @keyframes vt-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .screen.is-active {
      animation: none;
    }
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }

  /* ---------- Walidacja pól ---------- */
  .field-invalid {
    border-color: var(--danger-text) !important;
  }
  .field-error {
    color: var(--danger-text);
    font-size: 0.75rem;
    line-height: 1.4;
    padding-left: 0.25rem;
  }

  /* ---------- Komunikat odpowiedzi ---------- */
  #response-message.error p {
    padding: 0.5rem 0.75rem;
  }
  #response-message.pending p {
    padding: 0.5rem 0.75rem;
  }
  #response-message.success p {
    padding: 0.5rem 0.75rem;
  }
  #response-message.pending {
    background: var(--background-1);
    color: var(--muted);
  }
  #response-message.success {
    background: var(--foreground);
    color: var(--background);
  }
</style>

