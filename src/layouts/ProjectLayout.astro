---
import BaseLayout from "./BaseLayout.astro";
import { getTagTitles, getT } from "@/i18n/messages";
import { getRoute } from "@/i18n/routes";
import { MoveLeft, MoveRight } from "@lucide/astro";

const locale = Astro.currentLocale === "pl" ? "pl" : "en";
const t = getT(locale);

interface Props {
  metaTitle: string;
  metaDescription: string;
  title: string;
  description: string;
  client: string;
  cover?: string;
  tags?: string[];
  slug?: string;
  pubDate?: Date;
  prevProject?: { title: string; href: string; cover?: string };
  nextProject?: { title: string; href: string; cover?: string };
}

const {
  metaTitle,
  metaDescription,
  title,
  description,
  client,
  cover,
  tags = [],
  pubDate,
  prevProject,
  nextProject,
} = Astro.props as Props;

const listRoute = getRoute(locale, "projects");
const tagTitles = getTagTitles(locale);
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <main class="container mt-16">
    <article class="space-y-12 md:space-y-24 my-24">
      <header class="mb-6">
        <p class="mb-3 text-sm text-(--muted)">{client}</p>
        <h1 class="h1 md:max-w-3/4 lg:max-w-1/2">{description}</h1>
      </header>

      <div class="mb-12 relative aspect-video overflow-hidden">
        <div class="absolute w-full h-full object-cover bg-(--background-1)">
        </div>
        {
          cover && (
            <img
              src={cover}
              alt={title}
              class="absolute inset-0 w-full h-full object-cover"
            />
          )
        }
      </div>

      <slot />

      <div class="mb-3 flex justify-between text-sm text-(--muted)">
        {
          tags.length > 0 && (
            <p class="text-(--muted)">
              {t("projects.tagsTitle")}:&nbsp;
              <span>
                {tags.map((tag, index) => (
                  <span class="">
                    <a
                      href={`${listRoute}?tag=${encodeURIComponent(tag)}`}
                      class="text-(--foreground) hover:underline"
                    >
                      {tagTitles[tag] ?? tag}
                    </a>
                    {index < tags.length - 1 ? ", " : ""}
                  </span>
                ))}
              </span>
            </p>
          )
        }
        <p>
          <span>{t("projects.yearTitle")}:&nbsp;</span>
          {
            pubDate
              ? pubDate.toLocaleDateString(locale, {
                  year: "numeric",
                })
              : null
          }
        </p>
      </div>

      {
        (prevProject || nextProject) && (
          <nav
            class="grid grid-cols-2 gap-3 md:gap-4 lg:gap-6 border-t border-(--border) mt-3 pt-12"
            aria-label={t("projects.title")}
          >
            {prevProject && (
              <a href={prevProject.href} class="block group">
                <span class="mb-2 flex items-center gap-1 text-xs text-(--muted)">
                  <MoveLeft class="inline-flex w-4" />&nbsp;{t("projects.prevProject")}
                </span>
                <div class="relative aspect-3/2 overflow-hidden bg-(--background-1)">
                  {prevProject.cover && (
                    <img
                      src={prevProject.cover}
                      alt={prevProject.title}
                      loading="lazy"
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  )}
                  <div class="absolute inset-x-0 bottom-0 h-1/2 bg-linear-to-t from-black/60 to-transparent"></div>
                  <p class="absolute inset-x-3 bottom-3 text-(--white)">
                    {prevProject.title}
                  </p>
                </div>
              </a>
            )}
            {nextProject && (
              <a href={nextProject.href} class="col-start-2 block group text-right">
                <span class="mb-2 flex items-center justify-end gap-1 text-xs text-(--muted)">
                  {t("projects.nextProject")}&nbsp;<MoveRight class="inline-flex w-4" />
                </span>
                <div class="relative aspect-3/2 overflow-hidden bg-(--background-1)">
                  {nextProject.cover && (
                    <img
                      src={nextProject.cover}
                      alt={nextProject.title}
                      loading="lazy"
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  )}
                  <div class="absolute inset-x-0 bottom-0 h-1/2 bg-linear-to-t from-black/60 to-transparent"></div>
                  <p class="absolute inset-x-3 bottom-3 text-(--white)">
                    {nextProject.title}
                  </p>
                </div>
              </a>
            )}
          </nav>
        )
      }
    </article>
  </main>
</BaseLayout>
