---
import BaseLayout from "./BaseLayout.astro";
import { getT } from "@/i18n/messages";

const locale = Astro.currentLocale === "pl" ? "pl" : "en";
const t = getT(locale);

interface Props {
  metaTitle: string;
  metaDescription: string;
  title: string;
  description: string;
  client: string;
  cover?: string;
  tags?: string[];
  slug?: string;
  pubDate?: Date;
  prevProject?: { title: string; href: string };
  nextProject?: { title: string; href: string };
}

const {
  metaTitle,
  metaDescription,
  title,
  description,
  client,
  cover,
  tags = [],
  slug,
  pubDate,
  prevProject,
  nextProject,
} = Astro.props as Props;
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <main class="container mt-16">
    <article class="space-y-12 md:space-y-24 my-24">
      <header class="mb-6">
        <p class="mb-3 text-sm text-(--muted)">{client}</p>
        <h1 class="h1 md:max-w-3/4 lg:max-w-1/2">{description}</h1>
      </header>

      <div class="mb-12 relative aspect-video overflow-hidden">
        <div class="absolute w-full h-full object-cover bg-(--background-1)">
        </div>
        <!-- {
            cover && (
              <img
                src={cover}
                alt={title}
                class="absolute inset-0 w-full h-full object-cover"
              />
            )
          } -->
      </div>

      <slot />

      <div class="mb-3 flex justify-between text-sm text-(--muted)">
        {
          tags.length > 0 && (
            <p class="text-(--muted)">
              {t("projects.tagsTitle")}:&nbsp;
              <span>
                {tags.map((tag, index) => (
                  <span class="">
                    <span class="text-(--foreground)">{tag}</span>
                    {index < tags.length - 1 ? ", " : ""}
                  </span>
                ))}
              </span>
            </p>
          )
        }
        <p>
          <span>{t("projects.yearTitle")}:&nbsp;</span>
          {
            pubDate
              ? pubDate.toLocaleDateString(locale, {
                  year: "numeric",
                })
              : null
          }
        </p>
      </div>

      {
        (prevProject || nextProject) && (
          <nav
            class="flex justify-between gap-6 border-t border-(--border) pt-6"
            aria-label={t("projects.title")}
          >
            {prevProject && (
              <a href={prevProject.href} class="block hover:underline">
                <span class="block text-sm text-(--muted)">
                  ←&nbsp;{t("projects.prevProject")}
                </span>
                <span class="block">{prevProject.title}</span>
              </a>
            )}
            {nextProject && (
              <a href={nextProject.href} class="block text-right hover:underline">
                <span class="block text-sm text-(--muted)">
                  {t("projects.nextProject")}&nbsp;→
                </span>
                <span class="block">{nextProject.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>
  </main>
</BaseLayout>
