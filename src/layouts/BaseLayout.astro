---
import "../styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { type Locale } from "@/i18n/messages";
import LangRedirect from "@/components/LangRedirect.astro";
import CookieManager from "@/components/CookieManager/CookieManager.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props as Props;

const locale = (Astro.currentLocale === "pl" ? "pl" : "en") as Locale;

const siteName = "VISUAL LABEL";

const defaultTitle =
  locale === "pl"
    ? "VISUAL LABEL — Studio kreatywne"
    : "VISUAL LABEL — Creative Studio";

const defaultDescription =
  locale === "pl"
    ? "Studio projektowe tworzące nowoczesne strony internetowe."
    : "Creative studio building modern websites.";

const pageTitle = title ? `${title} — ${siteName}` : defaultTitle;
const pageDescription = description ?? defaultDescription;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale === "pl" ? "pl_PL" : "en_US"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <LangRedirect />
    <ClientRouter />
    <Font cssVariable="--font-copy" />
    <script is:inline>
      document.documentElement.classList.toggle(
        "reveal-on-scroll",
        "IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches,
      );
    </script>
  </head>
  <body>
    <Header />
    <main class="will-change transition-[filter] duration-300">
      <slot />
    </main>
    <Footer />
    <CookieManager />
    <script>
      import { animate, inView } from "motion";

      let stopObserving: (() => void) | undefined;

      document.addEventListener("astro:page-load", () => {
        stopObserving?.();
        if (!document.documentElement.classList.contains("reveal-on-scroll")) return;
        const elements = [...document.querySelectorAll<HTMLElement>(".reveal:not(.is-revealed)")];
        if (elements.length === 0) return;

        const reveal = (element: HTMLElement, delay = 0) => {
          if (element.classList.contains("is-revealed")) return;
          element.classList.add("is-revealed");
          element.getAnimations().forEach((animation) => animation.cancel());
          const styles = getComputedStyle(element);
          const y = styles.getPropertyValue("--reveal-y").trim() || "0px";
          animate(
            element,
            { opacity: [0, 1], y: [y, 0] },
            { duration: 0.6, delay, ease: "easeInOut" },
          );
        };

        const measured = elements.map((element, index) => ({
          element,
          index,
          top: element.getBoundingClientRect().top,
        }));
        const above = measured
          .filter(({ top }) => top < innerHeight)
          .sort((a, b) => a.top - b.top || a.index - b.index);
        const below = measured.filter(({ top }) => top >= innerHeight);

        above.forEach(({ element }, order) => reveal(element, order * 0.08));

        if (below.length > 0) {
          stopObserving = inView(below.map(({ element }) => element), (element) => {
            const delay = Number.parseFloat(getComputedStyle(element).getPropertyValue("--reveal-delay")) || 0;
            reveal(element as HTMLElement, delay / 1000);
          });
        }
      });

      document.addEventListener("astro:before-swap", (event) => {
        stopObserving?.();
        stopObserving = undefined;
        event.newDocument.documentElement.classList.toggle(
          "reveal-on-scroll",
          "IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches,
        );
      });
    </script>
  </body>
</html>
