---
import "@/styles/global.css";
import { type Locale } from "@/i18n/messages";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Button from "@/components/_ui/Button.astro";
import CookieManager from "@/components/CookieManager/CookieManager.astro";
import LangRedirect from "@/components/LangRedirect.astro";
import Footer from "@/components/Footer.astro";

const locale = (Astro.currentLocale === "pl" ? "pl" : "en") as Locale;
const pageTitle = "Coming Soon";

export const prerender = false;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <LangRedirect />
    <ClientRouter />
    <Font cssVariable="--font-copy" />
  </head>
  <body>
    <main class="container">
      <div
        class="relative h-[calc(100svh-3rem)] flex flex-col items-center justify-center"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill-rule="evenodd"
          stroke-linejoin="round"
          stroke-miterlimit="2"
          clip-rule="evenodd"
          viewBox="0 0 68 30"
          class="h-16 fill-(--foreground)"
        >
          <path
            ill-rule="nonzero"
            d="M3.235 11.193V0H0v14h5.115l6.992-14H8.554L3.235 11.193z"></path>
          <path fill-rule="nonzero" d="M12.997.007h3.237v13.996h-3.237z"></path>
          <path
            fill-rule="nonzero"
            d="M25.538 5.6l-2.208-.335c-1.144-.138-1.913-.493-1.913-1.243 0-.67.512-1.36 2.307-1.38 1.499 0 2.524.65 2.524 1.755h3.274c0-2.702-1.932-4.398-5.877-4.398-3.905 0-5.62 1.854-5.62 4.141 0 2.091 1.36 3.748 4.575 4.182l2.189.295c.828.099 1.696.257 1.696 1.302 0 .77-.789 1.4-2.722 1.42-1.735.04-2.74-.73-2.74-1.814h-3.354c0 2.78 1.992 4.476 6.233 4.476 4.141 0 5.995-1.814 5.995-4.338 0-2.781-1.795-3.708-4.359-4.063z"
          ></path>
          <path
            fill-rule="nonzero"
            d="M43.216 7.737V.007h-3.274V7.52c0 2.604-1.341 3.491-2.82 3.491-1.48 0-2.82-.907-2.82-3.53V.006h-3.294v7.81c0 4.26 2.78 5.996 6.074 5.996 3.254 0 6.134-1.913 6.134-6.075z"
          ></path>
          <path
            fill-rule="nonzero"
            d="M54.627 13.995H58.3L52.963-.008h-4.302l-5.418 14.003h3.55l1.117-3.146h5.621l1.096 3.146zm-5.844-5.662L50.08 4.66c.224-.67.447-1.461.65-2.172.223.71.446 1.502.65 2.172l1.278 3.673h-3.876z"
          ></path>
          <path
            fill-rule="nonzero"
            d="M64.614 2.832v11.162h3.393V-.008H57.909v2.84h6.705z"></path>
          <path
            fill-rule="nonzero"
            d="M3.385 27.169V16.006H-.007V30.01h10.098v-2.84H3.385z"></path>
          <path
            fill-rule="nonzero"
            d="M22.3 30.007h3.673l-5.338-14.003h-4.302l-5.418 14.003h3.551l1.116-3.146h5.622l1.096 3.146zm-5.845-5.662l1.299-3.673c.223-.67.446-1.462.65-2.172.222.71.446 1.502.649 2.172l1.278 3.673h-3.876z"
          ></path>
          <path
            fill-rule="nonzero"
            d="M37.079 22.397c1.177-.589 1.786-1.624 1.786-2.963 0-2.172-1.624-3.43-5.013-3.43H27.46v14.003h7.001c3.247 0 5.134-1.563 5.134-4.059 0-1.867-.77-3.044-2.516-3.551zm-3.734-3.694c1.278 0 2.03.305 2.03 1.32 0 1.014-.468 1.542-2.07 1.542h-2.456v-2.862h2.496zm.852 8.605H30.85V24.06h3.145c1.441 0 2.05.507 2.05 1.522 0 1.116-.67 1.725-1.847 1.725z"
          ></path>
          <path
            fill-rule="nonzero"
            d="M44.384 27.206v-2.942h6.19v-2.74h-6.19v-2.72h6.779v-2.8H40.995v14.003h10.31v-2.8h-6.92z"
          ></path>
          <path
            fill-rule="nonzero"
            d="M64.614 27.169V16.006h3.393V30.01H57.909v-2.84h6.705z"></path>
        </svg>
        <div class="absolute top-[calc(50%+2rem)] mt-4 space-y-8 text-center">
          <p class="font-mono text-(--muted)">coming soon</p>
          <Button href="/login" variant="ghost">Login</Button>
        </div>
      </div>
    </main>
    <Footer />
    <CookieManager />
  </body>
</html>
