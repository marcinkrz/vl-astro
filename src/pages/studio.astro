---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/_ui/Button.astro";
import { getRoute } from "@/i18n/routes";
import { getT } from "@/i18n/messages";
import { Clock5 } from "@lucide/astro";

import StudioCta from "@/../public/images/studio-cta.svg?raw";

const locale = (Astro.currentLocale === "pl" ? "pl" : "en") as "en";
const t = getT(locale);
---

<BaseLayout
  title="Studio"
  description="Visual Label is an independent design studio — brand identities and websites designed and built under one roof."
>
  <div class="container">
    <header class="mt-24 mb-16 md:mb-24">
      <p class="mb-4 text-xs font-mono uppercase text-(--muted)">Design studio</p>
      <h1 class="display mb-6">Studio</h1>
      <p class="max-w-[65ch] text-lg text-(--muted)">
        An independent, one-person design studio creating brand identities and
        websites — work that looks good, works well and sells.
      </p>
    </header>

    <div
      class="mb-16 md:mb-24 w-full aspect-3/2 md:aspect-video overflow-hidden bg-(--background-1)"
    >
      <img
        src="/images/studio-02.jpg"
        alt="Visual Label — studio workspace"
        loading="lazy"
        class="w-full h-full object-cover"
      />
    </div>

    <section class="mb-16 md:mb-24 border-t border-(--border)">
      <h2 class="mt-1 mb-6 text-xs font-mono uppercase text-(--muted)">
        About the studio
      </h2>
      <p class="h4 mb-6 max-w-[70ch]">
        No account managers, no middlemen — from the first brief to the final
        production files, every project stays in the hands of one designer.
      </p>
      <p class="max-w-[70ch] text-(--muted)">
        Graphic design meets code under one roof: identities, websites and
        print materials are designed and built together, so what looks good on
        paper also works in the browser.
      </p>
    </section>

    <section class="mb-16 md:mb-24 border-t border-(--border)">
      <h2 class="mt-1 mb-6 text-xs font-mono uppercase text-(--muted)">
        Services
      </h2>
      <ul class="grid gap-x-2 md:gap-x-4 lg:gap-x-6 gap-y-8 md:grid-cols-2">
        <li class="pt-4 border-t border-(--border)">
          <p class="mb-2 text-xs font-mono uppercase text-(--muted)">01</p>
          <h3 class="h4 mb-1">Logo &amp; brand identity</h3>
          <p class="text-sm text-(--muted)">
            Logos and visual identity systems that scale from a business card
            to a billboard.
          </p>
        </li>
        <li class="pt-4 border-t border-(--border)">
          <p class="mb-2 text-xs font-mono uppercase text-(--muted)">02</p>
          <h3 class="h4 mb-1">Websites</h3>
          <p class="text-sm text-(--muted)">
            Fast, accessible websites designed and built in-house — design and
            code under one roof.
          </p>
        </li>
        <li class="pt-4 border-t border-(--border)">
          <p class="mb-2 text-xs font-mono uppercase text-(--muted)">03</p>
          <h3 class="h4 mb-1">Online stores</h3>
          <p class="text-sm text-(--muted)">
            Conversion-focused e-commerce that stays true to your brand.
          </p>
        </li>
        <li class="pt-4 border-t border-(--border)">
          <p class="mb-2 text-xs font-mono uppercase text-(--muted)">04</p>
          <h3 class="h4 mb-1">Print design</h3>
          <p class="text-sm text-(--muted)">
            Business cards, catalogs and posters that carry the identity into
            the physical world.
          </p>
        </li>
      </ul>
    </section>

    <div
      class="mb-16 md:mb-24 w-full aspect-3/2 md:aspect-video overflow-hidden bg-(--background-1)"
    >
      <img
        src="/images/studio-03.jpg"
        alt="Printed brand identity materials on a desk"
        loading="lazy"
        class="w-full h-full object-cover"
      />
    </div>

    <section class="mb-12 border-t border-(--border)">
      <div class="grid gap-8 md:grid-cols-2 md:gap-x-4 lg:gap-x-6 items-center">
        <div>
          <h2 class="h3 mb-2">Have a project in mind?</h2>
          <p class="mb-6 max-w-[60ch] text-(--muted)">
            Fill out the short, non-binding brief — six quick questions, about
            a minute. You'll get a reply within two business days.
          </p>
          <div class="flex flex-wrap gap-2">
            <Button href={getRoute(locale, "brief")}>Start with the brief</Button>
            <Button href={getRoute(locale, "projects")} variant="outline">
              All projects
            </Button>
          </div>
          <p class="mt-2 p-2 inline-flex text-xs leading-tight text-(--muted)">
            <Clock5 class="h-4 mr-px" />{t("brief-form.[1].time")}
          </p>
        </div>
        <div class="w-full max-w-105 md:justify-self-end" set:html={StudioCta} />
      </div>
    </section>
  </div>
</BaseLayout>