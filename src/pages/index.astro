---
import { getT } from "@/i18n/messages";
import { getRoute } from "@/i18n/routes";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/_ui/Button.astro";
import { MoveRight } from "@lucide/astro";

const locale = Astro.currentLocale === "pl" ? "pl" : "en";
const t = getT(locale);

const projects = await getCollection(
  "projects",
  ({ data }) => data.locale === "en",
);

projects.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout>
  <main class="container-full space-y-24">
    <section class="mb-0 pt-48 min-h-[50vh] flex flex-col items-start">
      <h1
        class="xl:max-w-1/2 mb-3 display text-pretty reveal reveal-y-4"
      >
        Creative services for businesses
      </h1>
      <p
        class="lead text-balance text-(--muted) reveal reveal-y-8"
      >
        At Visual Label, we create the desired brand image, online and beyond.
      </p>
      <Button
        href={getRoute(locale, "brief")}
        variant="primary"
        size="large"
        class="mt-8 mb-12 reveal reveal-y-8"
      >
        Request a quote
      </Button>
    </section>

    <section
      class="-mx-3 md:-mx-4 pb-8 lg:mx-auto max-md:border-b border-(--border)"
    >
      <header
        class="mt-1 mb-6 pt-2 px-3 md:px-4 lg:px-0 flex justify-between border-t border-(--border) reveal reveal-y-8"
      >
        <h2 class="text-(--muted)">Services</h2>
      </header>

      <div class="relative w-full">
        <ul
          class="px-3 md:px-4 lg:px-0 grid grid-cols-2 lg:grid-cols-4 gap-3 max-lg:gap-y-6"
        >
          <li class="pb-4 reveal reveal-y-8">
            <div class="mb-4 aspect-square border border-(--border)"></div>
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h4 font-normal text-left whitespace-normal"
              >
                Logo &amp; brand identity
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Logos and visual identity systems that scale from a business card
              to a billboard.
            </p>
          </li>
          <li class="pb-4 reveal reveal-y-8">
            <div class="mb-4 aspect-square border border-(--border)"></div>
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h4 font-normal text-left whitespace-normal"
              >
                Websites
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Fast, accessible websites designed and built in-house, design and
              code under one roof.
            </p>
          </li>
          <li class="pb-4 reveal reveal-y-8">
            <div class="mb-4 aspect-square border border-(--border)"></div>
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h4 font-normal text-left whitespace-normal"
              >
                Online stores
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Conversion-focused e-commerce that stays true to your brand.
            </p>
          </li>
          <li class="pb-4 reveal reveal-y-8">
            <div class="mb-4 aspect-square border border-(--border)"></div>
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h4 font-normal text-left whitespace-normal"
              >
                Print design
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Business cards, catalogs and posters that carry the identity into
              the physical world.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <section class="mb-24 -mx-3 md:-mx-4 lg:mx-auto">
      <h2 class="display mb-4 px-3 md:px-4 lg:px-0">Check out our work</h2>
      <header
        class="mt-1 mb-6 pt-2 px-3 md:px-4 lg:px-0 flex justify-between border-t border-(--border) reveal reveal-y-8"
      >
        <h2 class="text-(--muted)">Projects</h2>
        <Button
          href={getRoute(locale, "projects")}
          variant="link"
          class="h-auto"
        >
          {t("projects.btnTitle")}
          <MoveRight class="w-4 stroke-2" />
        </Button>
      </header>
      <div class="relative w-full max-md:overflow-x-auto max-md:pl-2">
        <ul class="inline-flex md:grid grid-cols-3 md:gap-4 pb-4">
          {
            projects.map((project, index) => (
              <li
                style={`--reveal-delay: ${index * 50}ms`}
                class="max-md:w-[66vw] max-md:pr-2 reveal reveal-y-8"
              >
                <a class="group" href={`/projects/${project.id}`}>
                  <div class="relative aspect-3/2 overflow-hidden">
                    <div class="absolute w-full h-full object-cover bg-(--background-1)" />
                    {project.data.cover && (
                      <img
                        src={project.data.cover}
                        alt={project.data.title}
                        loading="lazy"
                        class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 group-active:scale-105"
                      />
                    )}
                  </div>
                  <div>
                    <h3 class="mt-2">{project.data.title}</h3>
                    <p class="col-span-3 text-sm text-(--muted)">
                      {project.data.description}
                    </p>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
