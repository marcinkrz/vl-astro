---
import { getT } from "@/i18n/messages";
import { getRoute } from "@/i18n/routes";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/_ui/Button.astro";
import Picture from "@/components/_ui/Picture.astro";
import AsciiGalaxy from "@/components/AsciiGalaxy.astro";
import { Galaxy, LaptopMinimal, MoveRight, Stamp, Store } from "@lucide/astro";

const locale = Astro.currentLocale === "pl" ? "pl" : "en";
const t = getT(locale);

const projects = await getCollection(
  "projects",
  ({ data }) => data.locale === "en",
);

projects.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout>
  <main class="container-full space-y-32">
    <section class="mb-6 min-h-[70vh] flex flex-col items-start justify-between">
      <div class="w-full">
        <h1 class="lg:max-w-2/3 xl:max-w-1/2 mt-24 mb-3 h1 text-balance reveal">Impactful designs and experiences. They drive your brand’s growth, both online and offline.</h1>
        <p class="mb-6 text-sm text-(--muted) reveal">Creative studio / Developer</p>
      </div>
      <div class="relative w-full aspect-3/4 sm:aspect-square md:aspect-3/2 lg:aspect-video border border-(--border) overflow-hidden reveal">
        <AsciiGalaxy label="ASCII animation of a galaxy rotating clockwise" />
      </div>
    </section>

    <section
      class="-mx-3 md:-mx-4 lg:mx-auto"
    >
      <header
        class="mt-1 mb-8 pt-2 px-3 md:px-4 lg:px-0 border-t border-(--border) reveal"
      >
        <h2 class="mb-3 text-(--muted)">Services</h2>
        <p class="lead">I help small businesses build a unique brand identity. From the initial discussion and brief, through sketches and proposals, to implementation and support.</p>
      </header>

      <div class="relative w-full">
        <ul
          class="px-3 md:px-4 lg:px-0 grid grid-cols-2 lg:grid-cols-4 gap-6 gap-y-0"
        >
          <li class="mb-12 reveal">
            <Galaxy
              class="w-20 lg:w-28 h-auto mb-4 stroke-[0.5]"
            />
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h3 text-left whitespace-normal"
              >
                Branding
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Logos and visual identity system that scale from a business card
              to a billboard.
            </p>
          </li>
          <li class="mb-12 reveal">
            <LaptopMinimal
              class="w-20 lg:w-28 h-auto mb-4 stroke-[0.5]"
            />
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h3 text-left whitespace-normal"
              >
                Websites
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Fast, accessible websites designed and built in-house, design and
              code under one roof.
            </p>
          </li>
          <li class="mb-12 reveal">
            <Store
              class="w-20 lg:w-28 h-auto mb-4 stroke-[0.5]"
            />
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h3 text-left whitespace-normal"
              >
                Online stores
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Conversion-focused e-commerce that stays true to your brand.
            </p>
          </li>
          <li class="mb-12 reveal">
            <Stamp
              class="w-20 lg:w-28 h-auto mb-4 stroke-[0.5]"
            />
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h3 text-left whitespace-normal"
              >
                Print design
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Business cards, catalogs and posters that carry the identity into
              the physical world.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <section class="mb-24 -mx-3 md:-mx-4 lg:mx-auto">
      <h2 class="display mb-4 px-3 md:px-4 lg:px-0 reveal">
        Check out our work
      </h2>
      <header
        class="mt-1 mb-6 pt-2 px-3 md:px-4 lg:px-0 flex justify-between border-t border-(--border) reveal"
      >
        <h2 class="text-(--muted)">Projects</h2>
        <Button
          href={getRoute(locale, "projects")}
          variant="link"
          class="h-auto"
        >
          {t("projects.btnTitle")}
          <MoveRight class="w-4 stroke-2" />
        </Button>
      </header>
      <div class="relative w-full max-md:overflow-x-auto max-md:pl-2">
        <ul class="inline-flex md:grid grid-cols-3 md:gap-4 pb-4">
          {
            projects.map((project, index) => (
              <li
                style={`--reveal-delay: ${index * 50}ms`}
                class="max-md:w-[66vw] max-md:pr-2 reveal"
              >
                <a class="group" href={`/projects/${project.id}`}>
                  {project.data.cover && (
                    <Picture
                      src={project.data.cover}
                      alt={project.data.title}
                      aspect="3/2"
                      sizes="(min-width: 768px) 33vw, 66vw"
                      imgClass="group-hover:scale-105 group-active:scale-105"
                    />
                  )}
                  <div>
                    <h3 class="mt-2">{project.data.title}</h3>
                    <p class="col-span-3 text-sm text-(--muted)">
                      {project.data.description}
                    </p>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
