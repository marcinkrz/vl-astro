---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/layouts/styleguide/Nav.astro";
import Logo from "@/layouts/styleguide/Logo.astro";
import Typography from "@/layouts/styleguide/Typography.astro";
---

<BaseLayout>
  <div class="mt-12 md:mt-16 md:grid md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
    <header class="max-md:mb-12 border-t border-(--border)">
      <div class="px-2 py-4 md:px-4 lg:p-6 text-xs font-mono uppercase">
        <h1 class="font-bold">
          Visual identity guidelines
        </h1>
        <p class="text-(--muted)">
          Updated: August 15, 2026
        </p>
      </div>
      <Nav
        sections={[
          {
            id: "logo",
            title: (
              <span>
                <span class="inline-flex w-6">01 </span>Logo
              </span>
            ),
            items: [
              { id: "logo", label: "Introduction" },
              { id: "logo-wordmark", label: "Wordmark" },
              { id: "logo-mark", label: "Logomark" },
              { id: "logo-color", label: "Color" },
            ],
          },
          {
            id: "typography",
            title: (
              <span>
                <span class="inline-flex w-6">02 </span>Typography
              </span>
            ),
            items: [
              { id: "typography", label: "Introduction" },
              { id: "typeface", label: "Typeface" },
              { id: "sizes", label: "Sizes" },
            ],
          },
        ]}
      />
    </header>
    <article class="md:col-span-3 lg:col-span-4 xl:col-span-5 md:border-l border-(--border)">
      <Logo
        logo_title={(
          <>
            <span>01 </span>
            <span>Logo</span>
          </>
        )}
        logo_lead="The Visual Label logo is the foundation of our identity and a key element of brand recognition for our customers. To accurately reproduce our logo on various media, please follow a few simple guidelines that will ensure its clarity and consistency in every situation."
        btn_text="Download logo"
        logo_wordmark_title="Logotype"
        logo_wordmark_lead="Our logo consists of a standalone logotype, which serves as the brand’s primary symbol. Its simple form ensures legibility and recognizability regardless of scale or application."
        logo_mark_title="Logomark"
        logo_mark_lead="The logomark is a standalone brand symbol intended for applications where the full wordmark is not necessary or does not provide sufficient legibility. It is particularly well suited to small formats such as favicons, icons, and avatars."
        logo_color_title="Color"
        logo_color_lead="Although the Visual Label logo and its graphic variations can be used in any of our brand colors, we strongly recommend using the monochrome version."
      />
      <Typography
        typography_title={(
          <>
            <span>02 </span>
            <span>Typography</span>
          </>
        )}
        typography_lead="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla et ex non erat vestibulum elementum. Sed consectetur neque massa, et porttitor ex posuere eu."
        btn_text="Get font"
      />
    </article>
  </div>
</BaseLayout>
