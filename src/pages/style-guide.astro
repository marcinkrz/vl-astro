8.007,13.994L68.007,-0.008L57.909,-0.008L57.909,2.832L64.614,2.832ZM43.216,7.737L43.216,0.007L39.942,0.007L39.942,7.52C39.942,10.124 38.601,11.011 37.122,11.011C35.642,11.011 34.302,10.104 34.302,7.481L34.302,0.006L31.008,0.006L31.008,7.816C31.008,12.076 33.788,13.812 37.082,13.812C40.336,13.812 43.216,11.899 43.216,7.737ZM48.783,8.333L50.08,4.66C50.304,3.99 50.527,3.199 50.73,2.488C50.953,3.198 51.176,3.99 51.38,4.66L52.658,8.333L48.782,8.333L48.783,8.333Z"
              ></path>
            </svg>
          </div>
        </section>
        <section
          id="logo-mark"
          class="scroll-mt-14 md:scroll-mt-16 p-2 md:p-4 lg:p-6 border-t border-(--border)"
        >
          <header class="max-w-340 mx-auto mb-8 md:grid grid-cols-2 gap-2 md:gap-4 lg:gap-6">
            <h3 class="h3 mb-4">Logomark</h3>
            <p class="mt-2 font-semibold">
              Used only when a very small scale is needed, such as for a website icon. This helps maintain the brand's visual consistency even in the most limited screen space.
            </p>
          </header>
          <div class="max-w-340 mx-auto grid grid-cols-3 gap-2 md:gap-4 lg:gap-6">
            <div class="relative w-full pb-[100%] flex bg-(--background-1)">
              <div class="absolute w-[50%] top-1/2 left-1/2 -translate-1/2 pb-[50%] bg-[#11110e]">
