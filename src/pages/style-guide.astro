---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/_ui/Button.astro";
import OverviewToggle from "@/components/OverviewToggle.astro";
import Nav from "@/layouts/styleguide/Nav.astro";

import Logo from "@/layouts/styleguide/Logo.astro";
import Typography from "@/layouts/styleguide/Typography.astro";
import Color from "@/layouts/styleguide/Color.astro";
import Components from "@/layouts/styleguide/Components.astro";
import HeroSection from "@/layouts/styleguide/HeroSection.astro"

import Hero01 from "@/../public/images/hero-01.svg?raw";
---

<BaseLayout>
  <OverviewToggle />
  <div
    id="styleguide"
    class="mt-12 md:mt-16 md:grid md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6"
  >
    <header class="max-md:mb-12 border-t border-(--border)">
      <div class="px-2 py-4 md:px-4 lg:p-6 text-xs font-mono uppercase">
        <h1 class="font-bold">Visual identity guidelines</h1>
        <p class="text-(--muted)">Updated: August 15, 2026</p>
      </div>
      <Nav
        sections={[
          {
            id: "logo",
            title: (
              <span>
                <span class="inline-flex w-6">01 </span>Logo
              </span>
            ),
            items: [
              { id: "logo", label: "Introduction" },
              { id: "logo-wordmark", label: "Wordmark" },
              { id: "logo-mark", label: "Logomark" },
              { id: "logo-color", label: "Color" },
            ],
          },
          {
            id: "typography",
            title: (
              <span>
                <span class="inline-flex w-6">02 </span>Typography
              </span>
            ),
            items: [
              { id: "typography", label: "Introduction" },
              { id: "typography-typeface", label: "Typeface" },
              { id: "typography-sizes", label: "Sizes & styles" },
            ],
          },
          {
            id: "color",
            title: (
              <span>
                <span class="inline-flex w-6">03 </span>Color
              </span>
            ),
            items: [
              { id: "color", label: "Introduction" },
              { id: "color-brand", label: "Brand colors" },
              { id: "color-palette", label: "Color shades" },
              { id: "color-gradients", label: "Gradients" },
              { id: "color-patterns", label: "Patterns" },
            ],
          },
          {
            id: "components",
            title: (
              <span>
                <span class="inline-flex w-6">04 </span>Components
              </span>
            ),
            items: [
              { id: "components", label: "Introduction" },
              { id: "components-buttons", label: "Buttons" },
              { id: "components-form-els", label: "Form elements" },
            ],
          },
          {
            id: "applications",
            title: (
              <span>
                <span class="inline-flex w-6">05 </span>Applications
              </span>
            ),
            items: [
              { id: "applications", label: "Introduction" },
              { id: "applications-hero", label: "Hero section" },
            ],
          },
        ]}
      />
    </header>
    <article
      class="md:col-span-3 lg:col-span-4 xl:col-span-5 pb-24 md:pb-32 space-y-24 md:space-y-32 md:border-l border-(--border)"
    >
      <Logo
        logo_title={(
          <>
            <span>01 </span>
            <span>Logo</span>
          </>
        )}
        logo_lead="The Visual Label logo is the foundation of our identity and a key element of brand recognition for our customers. To accurately reproduce our logo on various media, please follow a few simple guidelines that will ensure its clarity and consistency in every situation."
        btn_text="Download logo"
        logo_wordmark_title="Logotype"
        logo_wordmark_lead="Our logo consists of a standalone logotype, which serves as the brand’s primary symbol. Its simple form ensures legibility and recognizability regardless of scale or application."
        logo_mark_title="Logomark"
        logo_mark_lead="The logomark is a standalone brand symbol intended for applications where the full wordmark is not necessary or does not provide sufficient legibility. It is particularly well suited to small formats such as favicons, icons, and avatars."
        logo_color_title="Color"
        logo_color_lead="Although the Visual Label logo and its graphic variations can be used in any of our brand colors, we strongly recommend using the monochrome version."
      />
      <Typography
        typography_title={(
          <>
            <span>02 </span>
            <span>Typography</span>
          </>
        )}
        typography_lead="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla et ex non erat vestibulum elementum. Sed consectetur neque massa, et porttitor ex posuere eu."
        btn_text="Get font"
        typeface_title="Typeface"
        typeface_lead="The Inter font family, designed by Rasmus Andersson, is our primary typeface."
        typeface_heading={(
          <>
            Good design
            <br />
            is innovative
          </>
        )}
        typeface_subheading="Dieter Rams"
        typeface_copy="The possibilities for innovation are not, by any means, exhausted. Technological development is always offering new opportunities for innovative design. But innovative design always develops in tandem with innovative technology, and can never be an end in itself."
        sizes_title="Sizes & styles"
        sizes_lead="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc aliquet est ac eros scelerisque scelerisque. Aliquam erat volutpat. Phasellus quis fringilla dui."
        sizes_pangram="The quick brown fox jumps over the lazy dog."
      />
      <Color
        color_title={(
          <>
            <span>03 </span>
            <span>Color</span>
          </>
        )}
        color_lead="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla et ex non erat vestibulum elementum. Sed consectetur neque massa, et porttitor ex posuere eu."
        color_brand_title="Brand colors"
        color_brand_lead="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla et ex non erat vestibulum elementum. Sed consectetur neque massa, et porttitor ex posuere eu."
        color_shades_title="Color shades"
        color_shades_lead="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla et ex non erat vestibulum elementum. Sed consectetur neque massa, et porttitor ex posuere eu."
      />
      <Components
        components_title={(
          <>
            <span>04 </span>
            <span>Components</span>
          </>
        )}
        components_lead="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla et ex non erat vestibulum elementum. Sed consectetur neque massa, et porttitor ex posuere eu."
        components_buttons_title="Buttons"
        components_buttons_lead="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla et ex non erat vestibulum elementum. Sed consectetur neque massa, et porttitor ex posuere eu."
      >
        <div
          slot="buttons"
          id="components-buttons"
          class="space-y-4 md:space-y-8"
        >
          <div
            class="grid md:grid-cols-4 max-md:gap-y-2 gap-x-2 md:gap-x-4 lg:gap-x-6 justify-items-start pt-1 border-t border-(--border)"
          >
            <p
              class="mb-2 md:mb-4 md:col-span-4 text-xs md:text-sm text-(--muted)"
            >
              Primary variant
            </p>
            <Button size="large">Primary large</Button>
            <Button>Primary defaut</Button>
            <Button size="small">Primary small</Button>
            <span></span>
          </div>
          <div
            class="grid md:grid-cols-4 max-md:gap-y-2 gap-x-2 md:gap-x-4 lg:gap-x-6 justify-items-start pt-1 border-t border-(--border)"
          >
            <p
              class="mb-2 md:mb-4 md:col-span-4 text-xs md:text-sm text-(--muted)"
            >
              Outline variant
            </p>
            <Button variant="outline" size="large">Outline large</Button>
            <Button variant="outline">Outline defaut</Button>
            <Button variant="outline" size="small">Outline small</Button>
            <span></span>
          </div>
          <div
            class="grid md:grid-cols-4 max-md:gap-y-2 gap-x-2 md:gap-x-4 lg:gap-x-6 justify-items-start pt-1 border-t border-(--border)"
          >
            <p
              class="mb-2 md:mb-4 md:col-span-4 text-xs md:text-sm text-(--muted)"
            >
              Ghost variant
            </p>
            <Button variant="ghost" size="large">Ghost large</Button>
            <Button variant="ghost">Ghost defaut</Button>
            <Button variant="ghost" size="small">Ghost small</Button>
            <span></span>
          </div>
        </div>
      </Components>
      <HeroSection
        hero_title={(
          <>
            <span>05 </span>
            <span>Hero section</span>
          </>
        )}
        hero_lead="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla et ex non erat vestibulum elementum. Sed consectetur neque massa, et porttitor ex posuere eu."
      >
        <div class="max-w-340 mx-auto grid gap-16 md:gap-32 lg:gap-64 bg-linear-to-br from-(--background-1) to-(--background-2)">
          <div class="relative z-2 aspect-2/3 lg:aspect-4/3 xl:aspect-video flex flex-col items-start p-4 md:p-8 lg:p-16">
            <h1 class="display text-(--foreground) mb-6">Creating the desired <br />brand image, online <br/>and beyond.</h1>
            <div class="flex gap-4">
              <Button>Request a quote</Button>
              <Button variant="outline">All projects</Button>
            </div>
            <div class="absolute z-1 w-full lg:w-1/2 bottom-0 right-0">
              <div set:html={Hero01}></div>
            </div>
          </div>
        </div>
      </HeroSection>
    </article>
  </div>
</BaseLayout>
