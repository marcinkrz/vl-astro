        <section
          id="logo-color"
          class="scroll-mt-14 md:scroll-mt-16 p-2 md:p-4 lg:p-6 border-t border-(--border)"
        >
          <header class="max-w-340 mx-auto mb-8 pt-2 md:grid grid-cols-2 gap-2 md:gap-4 lg:gap-6">
            <h3 class="h3 mb-4">Color</h3>
            <p class="mt-2 font-semibold">
              Although the Visual Label logo and its graphic variations can be used in any of our brand colors, we strongly recommend using the monochrome version.
            </p>
          </header>
          <div class="max-w-340 mx-auto grid grid-cols-6 gap-2 md:gap-4 lg:gap-6">
            <div
              class="col-span-3 relative w-full pb-[62%] flex bg-(--foreground)"
            >
