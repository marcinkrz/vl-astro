<script>
  const toggles = document.querySelectorAll<HTMLAnchorElement>("[data-toggle]");

  toggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const id = toggle.dataset.toggle;

      if (!id) return;

      const menu = document.querySelector<HTMLElement>(`[data-menu="${id}"]`);
      const icon = toggle.querySelector<HTMLElement>("[data-icon]");

      if (!menu || !icon) return;

      const isOpen = toggle.getAttribute("aria-expanded") === "true";

      toggles.forEach((otherToggle) => {
        if (otherToggle === toggle) return;

        const otherId = otherToggle.dataset.toggle;
        if (!otherId) return;

        const otherMenu = document.querySelector<HTMLElement>(
          `[data-menu="${otherId}"]`
        );
        const otherIcon =
          otherToggle.querySelector<HTMLElement>("[data-icon]");

        if (!otherMenu || !otherIcon) return;

        otherToggle.setAttribute("aria-expanded", "false");
        otherMenu.hidden = true;
        otherIcon.textContent = "+";
      });

      toggle.setAttribute("aria-expanded", String(!isOpen));
      menu.hidden = isOpen;
      icon.textContent = isOpen ? "+" : "−";
    });
  });
</script>
