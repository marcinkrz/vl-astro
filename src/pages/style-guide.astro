---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/_ui/Button.astro";
---

<BaseLayout>
  <div class="mt-14 md:mt-16 md:grid grid-cols-6">
    <header class="border-t border-(--border)">
      <div class="p-2 md:p-4 lg:p-6">
        <h1 class="text-xs font-mono font-bold uppercase">
          Visual identity guidelines
        </h1>
        <p class="text-xs font-mono uppercase text-(--muted)">
          Updated: August 15, 2026
        </p>
      </div>
      <nav class="md:sticky top-16 font-semibold border-t border-(--border)">
        <div>
          <button
            type="button"
            data-toggle="logo"
            aria-expanded="false"
            class="w-full flex items-center justify-between py-1 px-2 md:px-4 lg:px-6 hover:bg-(--background-1) cursor-pointer"
          >
            <span><span class="inline-flex w-6">01 </span>Logo</span>
            <span
              aria-hidden="true"
              data-icon
              class="font-normal text-(--muted) text-lg leading-none"
            >
              +
            </span>
          </button>
          <ul data-menu="logo" hidden class="group">
            <li>
              <a
                href="#logo"
                class="block pl-8 md:pl-10 lg:pl-12 py-1 text-(--muted) hover:bg-(--background-1) hover:text-(--foreground)"
              >
                Introduction
              </a>
            </li>
            <li>
              <a
                href="#logo-wordmark"
                class="block pl-8 md:pl-10 lg:pl-12 py-1 text-(--muted) hover:bg-(--background-1) hover:text-(--foreground)"
              >
                Logo
              </a>
            </li>
            <li>
              <a
                href="#logo-mark"
                class="block pl-8 md:pl-10 lg:pl-12 py-1 text-(--muted) hover:bg-(--background-1) hover:text-(--foreground)"
              >
                Logomark
              </a>
            </li>
            <li>
              <a
                href="#logo-color"
                class="block pl-8 md:pl-10 lg:pl-12 py-1 text-(--muted) hover:bg-(--background-1) hover:text-(--foreground)"
              >
                Color
              </a>
            </li>
          </ul>
        </div>
        <div>
          <button
            type="button"
            data-toggle="typography"
            aria-expanded="false"
            class="w-full flex items-center justify-between py-1 px-2 md:px-4 lg:px-6 hover:bg-(--background-1) cursor-pointer"
          >
            <span><span class="inline-flex w-6">02 </span>Typography</span>
            <span
              aria-hidden="true"
              data-icon
              class="font-normal text-(--muted) text-lg leading-none"
            >
              +
            </span>
          </button>
          <ul data-menu="typography" hidden class="group">
            <li>
              <a
                href="#typography"
                class="block pl-8 md:pl-10 lg:pl-12 py-1 text-(--muted) hover:bg-(--background-1) hover:text-(--foreground)"
              >
                Introduction
              </a>
            </li>
            <li>
              <a
                href="#typeface"
                class="block pl-8 md:pl-10 lg:pl-12 py-1 text-(--muted) hover:bg-(--background-1) hover:text-(--foreground)"
              >
                Typeface
              </a>
            </li>
            <li>
              <a
                href="#sizes"
                class="block pl-8 md:pl-10 lg:pl-12 py-1 text-(--muted) hover:bg-(--background-1) hover:text-(--foreground)"
              >
                Sizes
              </a>
            </li>
          </ul>
        </div>
      </nav>
    </header>
    <article
      class="md:col-span-5 space-y-8 md:space-y-16 lg:space-y-32 md:border-l border-(--border)"
    >
      <section id="logo" class="scroll-mt-14 md:scroll-mt-16 space-y-8 md:space-y-16 lg:space-y-32">
        <header>
          <div class="relative pt-[33%] md:pt-[25%] px-2 md:px-4 lg:px-6 bg-(--foreground) text-(--background)">
            <div class="max-w-340 mx-auto">
              <h2
                class="display pb-2 md:pb-4 lg:pb-6 grid grid-cols-2"
              >
                <span>01 </span><span>Logo</span>
              </h2>
            </div>
          </div>
          <div class="px-2 md:px-4 lg:px-6">
            <div class="max-w-340 mx-auto">
              <p class="h3 mt-4 mb-8">
                The Visual Label logo is the foundation of our identity and a key element of brand recognition for our customers. To accurately reproduce our logo on various media, please follow a few simple guidelines that will ensure its clarity and consistency in every situation.
              </p>
              <Button variant="primary" size="large">Pobierz logo</Button>
            </div>
          </div>
        </header>
        <section
          id="logo-wordmark"
          class="scroll-mt-14 md:scroll-mt-16 p-2 md:p-4 lg:p-6 border-t border-(--border)"
        >
          <header class="max-w-340 mx-auto mb-8 md:grid grid-cols-2 gap-2 md:gap-4 lg:gap-6">
            <h3 class="h3 mb-4">Logo</h3>
            <p class="mt-2 font-semibold">
              Our logo is a concise representation of our brand. It is distinctive, memorable, and works well at various scales and on various media.
            </p>
