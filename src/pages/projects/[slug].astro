}
const { project } = Astro.props;
const { Content } = await render(project);
*/

/* OUTPUT: SERVER */
const projects = await getCollection("projects", (e) => e.data.locale === "en");
const project = projects.find((e) => e.data.slug === slug);
if (!project) {
  return new Response(null, { status: 404 });
}
projects.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const index = projects.indexOf(project);
const prevProject = projects[(index - 1 + projects.length) % projects.length];
const nextProject = projects[(index + 1) % projects.length];
const { Content } = await render(project);
---

<ProjectLayout
  metaTitle={project.data.metaTitle}
  metaDescription={project.data.metaDescription}
  title={project.data.title}
  description={project.data.description}
  client={project.data.client}
  cover={project.data.cover}
  tags={project.data.tags}
  slug={project.data.slug}
  pubDate={project.data.pubDate}
  prevProject={{ title: prevProject.data.title, href: `/projects/${prevProject.id}`, cover: prevProject.data.cover }}
  nextProject={{ title: nextProject.data.title, href: `/projects/${nextProject.id}`, cover: nextProject.data.cover }}
>
  <Content />
</ProjectLayout>
