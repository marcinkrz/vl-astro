---
import "@/styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import CookieManager from "@/components/CookieManager/CookieManager.astro";
import Input from "@/components/_ui/Input.astro";
import Button from "@/components/_ui/Button.astro";
import Footer from "@/components/Footer.astro";

import { getT, type Locale } from "@/i18n/messages";
const locale = (Astro.currentLocale === "pl" ? "pl" : "en") as Locale;
const t = getT(locale);
const pageTitle = "Login";

export const prerender = false;

if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();
  const password = data.get("password");

  if (password === import.meta.env.SITE_PASSWORD) {
    Astro.cookies.set("site_auth", "true", {
      path: "/",
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: "lax",
    });
    return Astro.redirect("/");
  }
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <ClientRouter />
    <Font cssVariable="--font-copy" />
  </head>
  <body>
    <main class="container">
      <div class="h-[calc(100svh-66px)] flex items-center justify-center">
        <form method="POST" class="space-y-2">
          <label class="relative block">
            <Input
              type="password"
              id="password"
              name="password"
              placeholder=" "
              required
              class="peer"
            />
            <span
              class={`
              pointer-events-none
              absolute left-2 top-5 -translate-y-1/2
              px-[0.5ch]
              bg-(--background)
              text-(--muted)
              transition-all duration-150
              peer-focus:top-0
              peer-focus:-translate-y-1/2
              peer-focus:text-sm
              peer-not-placeholder-shown:top-0
              peer-not-placeholder-shown:-translate-y-1/2
              peer-not-placeholder-shown:text-sm
            `}
            >
              Hasło
            </span>
          </label>
          <Button
            class="w-full"
            type="submit"
            variant="primary"
            size="large"
          >Log in</Button>
        </form>
      </div>
    </main>
    <Footer />
    <CookieManager />
  </body>
</html>
