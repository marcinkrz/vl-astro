---
import { getT } from "@/i18n/messages";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectsTagFilter from "@/components/ProjectsTagFilter.astro";
import Picture from "@/components/Picture.astro";
import { getCollection } from "astro:content";

const locale = Astro.currentLocale === "pl" ? "pl" : "en";
const t = getT(locale);

const projects = await getCollection(
  "projects",
  ({ data }) => data.locale === "pl",
);

projects.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const tags = [...new Set(projects.flatMap((project) => project.data.tags))].sort();
---

<BaseLayout title="Projekty" description="">
  <main class="container-full mt-36 mb-24">
    <h1 class="display mb-3 reveal">
      {t("projects.title")}
    </h1>
    <p class="lead text-(--muted) mb-12 reveal">
      {t("projects.description")}
    </p>
    <ProjectsTagFilter tags={tags} ariaLabel={t("projects.tagsTitle")} />
    <ul class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 mb-24">
      {
        projects.map((project, index) => (
          <li
            class="will-change-transform"
            data-project-card
            data-project-tags={JSON.stringify(project.data.tags)}
          >
            <a class="group" href={`/pl/projekty/${project.id}`}>
              <article>
                {project.data.cover && (
                  <Picture
                    src={project.data.cover}
                    alt={project.data.title}
                    aspect="3/2"
                    class="mb-3"
                    loading={index < 3 ? "eager" : "lazy"}
                    sizes="(min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw"
                    imgClass="transition-transform duration-300 group-hover:scale-105 group-active:scale-105"
                  />
                )}
                <h2 class="h4">{project.data.title}</h2>
                <p class="col-span-3 text-(--muted)">
                  {project.data.description}
                </p>
              </article>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
