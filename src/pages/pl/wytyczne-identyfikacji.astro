---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/layouts/styleguide/Nav.astro";
import Logo from "@/layouts/styleguide/Logo.astro";
import Typography from "@/layouts/styleguide/Typography.astro";
import Color from "@/layouts/styleguide/Color.astro";
---

<BaseLayout>
  <div
    class="mt-12 md:mt-16 md:grid md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6"
  >
    <header class="max-md:mb-12 border-t border-(--border)">
      <div class="px-2 py-4 md:px-4 lg:p-6 text-xs font-mono uppercase">
        <h1 class="font-bold">Wytyczne identyfikacji wizualnej</h1>
        <p class="text-(--muted)">Aktualizacja: 15-08-2026 r.</p>
      </div>
      <Nav
        sections={[
          {
            id: "logo",
            title: (
              <span>
                <span class="inline-flex w-6">01 </span>Logo
              </span>
            ),
            items: [
              { id: "logo", label: "Wprowadzenie" },
              { id: "logo-wordmark", label: "Logotyp" },
              { id: "logo-mark", label: "Sygnet" },
              { id: "logo-color", label: "Kolor" },
            ],
          },
          {
            id: "typography",
            title: (
              <span>
                <span class="inline-flex w-6">02 </span>Typografia
              </span>
            ),
            items: [
              { id: "typography", label: "Wprowadzenie" },
              { id: "typography-typeface", label: "Krój pisma" },
              { id: "typography-sizes", label: "Rozmiary i style" },
            ],
          },
          {
            id: "color",
            title: (
              <span>
                <span class="inline-flex w-6">03 </span>Kolor
              </span>
            ),
            items: [
              { id: "color", label: "Wprowadzenie" },
              { id: "color-brand", label: "Kolory marki" },
              { id: "color-gradients", label: "Gradienty" },
              { id: "color-patterns", label: "Wzory" },
            ],
          },
          {
            id: "components",
            title: (
              <span>
                <span class="inline-flex w-6">04 </span>Komponenty
              </span>
            ),
            items: [
              { id: "components", label: "Wprowadzenie" },
              { id: "components-buttons", label: "Przyciski" },
              { id: "components-cards", label: "Karty" },
              { id: "components-covers", label: "Okładki" },
            ],
          },
        ]}
      />
    </header>
    <article
      class="md:col-span-3 lg:col-span-4 xl:col-span-5 pb-24 md:pb-32 space-y-24 md:space-y-32 md:border-l border-(--border)"
    >
      <Logo
        logo_title={(<><span>01 </span><span>Logo</span></>)}
        logo_lead="Logo Visual Label, stanowi fundament naszej tożsamości i jest kluczowym elementem rozpoznawczym dla naszych klientów. Aby wiernie odtworzyć nasze logo na różnych nośnikach, należy przestrzegać kilku prostych wytycznych, które zapewnią jego wyraźność i spójność w każdej sytuacji."
        btn_text="Pobierz logo"
        logo_wordmark_title="Logotyp"
        logo_wordmark_lead="Nasze logo tworzy samodzielny logotyp, który stanowi podstawowy znak marki. Jego prosta forma zapewnia czytelność i rozpoznawalność niezależnie od skali i zastosowania."
        logo_mark_title="Sygnet"
        logo_mark_lead="Sygnet jest samodzielnym symbolem marki przeznaczonym do zastosowań, w których pełny logotyp nie jest konieczny lub nie zapewnia odpowiedniej czytelności. Sprawdza się szczególnie w małych formatach, takich jak favicon, ikona czy avatar."
        logo_color_title="Kolor"
        logo_color_lead="Chociaż logo Visual Label i jego warianty graficzne mogą być wykorzystywane w dowolnym kolorze naszej marki, zdecydowanie zaleca się stosowanie wersji monochromatycznej."
      />
      <Typography
        typography_title={(<><span>02 </span><span>Typografia</span></>)}
        typography_lead="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla et ex non erat vestibulum elementum. Sed consectetur neque massa, et porttitor ex posuere eu."
        btn_text="Pobierz czcionkę"
        typeface_title="Krój pisma"
        typeface_lead="Rodzina czcionek Inter, zaprojektowana przez Rasmusa Anderssona, jest naszym głównym krojem pisma."
        typeface_heading={(
          <>
            Dobry projekt
            <br />
            jest innowacyjny
          </>
        )}
        typeface_subheading="Dieter Rams"
        typeface_copy="Możliwości wprowadzania innowacji nie są bynajmniej wyczerpane. Rozwój technologiczny nieustannie stwarza nowe możliwości dla innowacyjnego projektowania. Jednak innowacyjne projektowanie zawsze rozwija się równolegle z innowacyjną technologią i nigdy nie może być celem samym w sobie."
        sizes_title="Rozmiary i style"
        sizes_lead="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc aliquet est ac eros scelerisque scelerisque. Aliquam erat volutpat. Phasellus quis fringilla dui."
        sizes_pangram="Mężny bądź, chroń pułk twój i sześć flag."
      />
      <Color
        color_title={(<><span>03 </span><span>Kolor</span></>)}
        color_lead="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla et ex non erat vestibulum elementum. Sed consectetur neque massa, et porttitor ex posuere eu."
        color_brand_title="Kolory marki"
        color_brand_lead="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla et ex non erat vestibulum elementum. Sed consectetur neque massa, et porttitor ex posuere eu."
      />
    </article>
  </div>
</BaseLayout>
