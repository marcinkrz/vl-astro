---
import { getT } from "@/i18n/messages";
import { getRoute } from "@/i18n/routes";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/_ui/Button.astro";

const locale = Astro.currentLocale === "pl" ? "pl" : "en";
const t = getT(locale);

const projects = await getCollection(
  "projects",
  ({ data }) => data.locale === "pl",
);

projects.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout>
  <main class="container-full">
    <section class="pt-28 md:pt-32 pb-12 min-h-[50vh] flex flex-col items-start">
      <h1 class="mb-8 display text-balance motion-opacity-in-0 motion-translate-y-in-[4rem]">
        Budowanie pożądanego <br/>wizerunku marki, w sieci <span class="sm:block"></span>i poza nią.
      </h1>
      <Button
        href={getRoute(locale, "brief")}
        variant="primary"
        size="large"
        class="motion-opacity-in-0 motion-translate-y-in-[8rem]"
      >
        Wyceń projekt
      </Button>
    </section>
    <section class="mb-24 -mx-3 md:-mx-4 lg:mx-auto">
      <header class="mt-1 mb-3 px-3 md:px-4 lg:px-0 flex justify-between border-t border-(--border) motion-opacity-in-0 motion-translate-y-in-[12rem]">
        <h2 class="text-(--muted)">Projekty</h2>
        <Button href={getRoute(locale, "projects")} variant="link" class="items-baseline">
          {t("projects.btnTitle")}
        </Button>
      </header>
      <div class="relative w-full max-md:overflow-x-auto max-md:pl-2">
        <ul class="inline-flex md:grid grid-cols-3 md:gap-4">
          {
            projects.map((project, index) => (
              <li
                style={`--delay: ${index * 50}ms`}
                class="max-md:w-[66vw] max-md:pr-2 motion-opacity-in-0 motion-translate-y-in-100 motion-delay-(--delay)"
              >
                <a class="group" href={`/pl/projekty/${project.id}`}>
                  <div class="relative aspect-3/2 overflow-hidden">
                    <div
                      class="absolute w-full h-full object-cover bg-(--background-1)"
                    ></div>
                    {project.data.cover && (
                      <img
                        src={project.data.cover}
                        alt={project.data.title}
                        loading="lazy"
                        class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 group-active:scale-105"
                      />
                    )}
                  </div>
                  <div>
                    <h2 class="h4 mt-2">{project.data.title}</h2>
                    <p class="col-span-3 text-sm text-(--muted)">
                      {project.data.description}
                    </p>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
