---
import { getT } from "@/i18n/messages";
import { getRoute } from "@/i18n/routes";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/_ui/Button.astro";
import Picture from "@/components/_ui/Picture.astro";
import AsciiGalaxy from "@/components/AsciiGalaxy.astro";
import { Galaxy, LaptopMinimal, MoveRight, Stamp, Store } from "@lucide/astro";

const locale = Astro.currentLocale === "pl" ? "pl" : "en";
const t = getT(locale);

const projects = await getCollection(
  "projects",
  ({ data }) => data.locale === "pl",
);

projects.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout>
  <main class="container-full space-y-32">
    <section class="mb-6 min-h-[70vh] flex flex-col items-start justify-between">
      <div class="w-full">
        <h1 class="lg:max-w-2/3 xl:max-w-1/2 mt-24 mb-3 h1 text-balance reveal">Efektowne projekty i przemyślane doświadczenia. Napędzają rozwój Twojej marki, w sieci i poza nią.</h1>
        <p class="mb-6 text-sm text-(--muted) reveal">Studio kreatywne / Developer</p>
      </div>
      <div class="relative w-full aspect-3/4 sm:aspect-square md:aspect-3/2 lg:aspect-video border border-(--border) overflow-hidden reveal">
        <AsciiGalaxy label="Animacja ASCII galaktyki obracającej się zgodnie z ruchem wskazówek zegara" />
      </div>
    </section>

    <section
      class="-mx-3 md:-mx-4 lg:mx-auto"
    >
      <header
        class="mt-1 mb-8 pt-2 px-3 md:px-4 lg:px-0 border-t border-(--border) reveal"
      >
        <h2 class="mb-3 text-(--muted)">Usługi</h2>
        <p class="lead">Pomagam małym firmom zbudować unikalny wizerunek. Od rozmowy i briefu, przez szkice i propozycje, po wdrożenie i wsparcie.</p>
      </header>

      <div class="relative w-full">
        <ul
          class="px-3 md:px-4 lg:px-0 grid grid-cols-2 lg:grid-cols-4 gap-6 gap-y-0"
        >
          <li class="mb-12 reveal">
            <Galaxy class="w-[50%] h-auto mb-3 stroke-[0.5]" />
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h3 text-left whitespace-normal"
              >
                Identyfikacjia
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Logo i system identyfikacji wizualnej, które skalują się od
              wizytówki do bilbordu.
            </p>
          </li>
          <li class="mb-12 reveal">
            <LaptopMinimal class="w-[50%] h-auto mb-3 stroke-[0.5]" />
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h3 text-left whitespace-normal"
              >
                Strony internetowe
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Szybkie, dostępne strony projektowane i kodowane w jednym miejscu,
              projekt i kod pod jednym dachem.
            </p>
          </li>
          <li class="mb-12 reveal">
            <Store class="w-[50%] h-auto mb-3 stroke-[0.5]" />
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h3 text-left whitespace-normal"
              >
                Sklepy internetowe
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Sklepy nastawione na konwersję, spójne z marką klienta.
            </p>
          </li>
          <li class="mb-12 reveal">
            <Stamp class="w-[50%] h-auto mb-3 stroke-[0.5]" />
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h3 text-left whitespace-normal"
              >
                Projekt druku
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Wizytówki, katalogi i plakaty, które przenoszą identyfikację do
              świata fizycznego.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <section class="mb-24 -mx-3 md:-mx-4 lg:mx-auto">
      <h2 class="display mb-4 px-3 md:px-4 lg:px-0 reveal">
        Sprawdź nasze realizacje
      </h2>
      <header
        class="mt-1 mb-6 pt-2 px-3 md:px-4 lg:px-0 flex justify-between border-t border-(--border) reveal"
      >
        <h2 class="text-(--muted)">Projekty</h2>
        <Button
          href={getRoute(locale, "projects")}
          variant="link"
          class="h-auto"
        >
          {t("projects.btnTitle")}
          <MoveRight class="w-4 stroke-2" />
        </Button>
      </header>
      <div class="relative w-full max-md:overflow-x-auto max-md:pl-2">
        <ul class="inline-flex md:grid grid-cols-3 md:gap-4 pb-4">
          {
            projects.map((project, index) => (
              <li
                style={`--reveal-delay: ${index * 50}ms`}
                class="max-md:w-[66vw] max-md:pr-2 reveal"
              >
                <a class="group" href={`/pl/projekty/${project.id}`}>
                  {project.data.cover && (
                    <Picture
                      src={project.data.cover}
                      alt={project.data.title}
                      aspect="3/2"
                      sizes="(min-width: 768px) 33vw, 66vw"
                      imgClass="group-hover:scale-105 group-active:scale-105"
                    />
                  )}
                  <div>
                    <h3 class="mt-2">{project.data.title}</h3>
                    <p class="col-span-3 text-sm text-(--muted)">
                      {project.data.description}
                    </p>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
