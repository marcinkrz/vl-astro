---
import { getT } from "@/i18n/messages";
import { getRoute } from "@/i18n/routes";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/_ui/Button.astro";
import Picture from "@/components/_ui/Picture.astro";
import { Galaxy, LaptopMinimal, MoveRight, Stamp, Store } from "@lucide/astro";

const locale = Astro.currentLocale === "pl" ? "pl" : "en";
const t = getT(locale);

const projects = await getCollection(
  "projects",
  ({ data }) => data.locale === "pl",
);

projects.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout>
  <main class="container-full space-y-32">
    <section class="mb-0 min-h-[70vh] flex flex-col items-start justify-end">
      <h1 class="xl:max-w-1/2 mb-3 display text-pretty reveal">
        Kreatywne usługi dla biznesu
      </h1>
      <p class="lead text-(--muted) reveal">
        W Visual Label tworzymy pożądany wizerunek marki, w sieci i poza nią.
      </p>
      <Button
        href={getRoute(locale, "brief")}
        variant="outline"
        size="large"
        class="my-8 reveal"
      >
        Wyceń projekt
      </Button>
    </section>

    <section
      class="-mx-3 md:-mx-4 lg:mx-auto max-md:border-b border-(--border)"
    >
      <header
        class="mt-1 mb-8 pt-2 px-3 md:px-4 lg:px-0 flex justify-between border-t border-(--border) reveal"
      >
        <h2 class="text-(--muted)">Usługi</h2>
      </header>

      <div class="relative w-full">
        <ul
          class="px-3 md:px-4 lg:px-0 grid grid-cols-2 lg:grid-cols-4 gap-3 max-lg:gap-y-6"
        >
          <li class="mb-12 reveal">
            <Galaxy class="w-20 lg:w-28 h-auto mb-4 stroke-[0.5]" />
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h2 text-left whitespace-normal"
              >
                Identyfikacja
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Logo i systemy identyfikacji wizualnej, które skalują się od
              wizytówki do bilbordu.
            </p>
          </li>
          <li class="mb-12 reveal">
            <LaptopMinimal class="w-20 lg:w-28 h-auto mb-4 stroke-[0.5]" />
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h2 text-left whitespace-normal"
              >
                Strony internetowe
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Szybkie, dostępne strony projektowane i kodowane w jednym miejscu,
              projekt i kod pod jednym dachem.
            </p>
          </li>
          <li class="mb-12 reveal">
            <Store class="w-20 lg:w-28 h-auto mb-4 stroke-[0.5]" />
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h2 text-left whitespace-normal"
              >
                Sklepy internetowe
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Sklepy nastawione na konwersję, spójne z marką klienta.
            </p>
          </li>
          <li class="mb-12 reveal">
            <Stamp class="w-20 lg:w-28 h-auto mb-4 stroke-[0.5]" />
            <h3 class="mb-1">
              <Button
                variant="link"
                class="h-auto h2 text-left whitespace-normal"
              >
                Projekt druku
              </Button>
            </h3>
            <p class="text-sm text-(--muted) text-pretty">
              Wizytówki, katalogi i plakaty, które przenoszą identyfikację do
              świata fizycznego.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <section class="mb-24 -mx-3 md:-mx-4 lg:mx-auto">
      <h2 class="display mb-4 px-3 md:px-4 lg:px-0 reveal">
        Sprawdź nasze realizacje
      </h2>
      <header
        class="mt-1 mb-6 pt-2 px-3 md:px-4 lg:px-0 flex justify-between border-t border-(--border) reveal"
      >
        <h2 class="text-(--muted)">Projekty</h2>
        <Button
          href={getRoute(locale, "projects")}
          variant="link"
          class="h-auto"
        >
          {t("projects.btnTitle")}
          <MoveRight class="w-4 stroke-2" />
        </Button>
      </header>
      <div class="relative w-full max-md:overflow-x-auto max-md:pl-2">
        <ul class="inline-flex md:grid grid-cols-3 md:gap-4 pb-4">
          {
            projects.map((project, index) => (
              <li
                style={`--reveal-delay: ${index * 50}ms`}
                class="max-md:w-[66vw] max-md:pr-2 reveal"
              >
                <a class="group" href={`/pl/projekty/${project.id}`}>
                  {project.data.cover && (
                    <Picture
                      src={project.data.cover}
                      alt={project.data.title}
                      aspect="3/2"
                      sizes="(min-width: 768px) 33vw, 66vw"
                      imgClass="group-hover:scale-105 group-active:scale-105"
                    />
                  )}
                  <div>
                    <h3 class="mt-2">{project.data.title}</h3>
                    <p class="col-span-3 text-sm text-(--muted)">
                      {project.data.description}
                    </p>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
