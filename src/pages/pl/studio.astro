---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/_ui/Button.astro";
import { getRoute } from "@/i18n/routes";

const locale = (Astro.currentLocale === "pl" ? "pl" : "en") as "pl";
---

<BaseLayout
  title="Studio"
  description="Visual Label to niezależne studio projektowe — identyfikacje wizualne i strony internetowe zaprojektowane i zbudowane przez jednego projektanta."
>
  <div class="container">
    <h1 class="display mt-24 mb-4">Studio</h1>
    <p class="mb-12 max-w-[65ch] text-(--muted)">
      Visual Label to niezależne studio projektowe. Tworzę identyfikacje
      wizualne i projektuję strony internetowe — tak, żeby dobrze wyglądały i
      skutecznie działały.
    </p>

    <div
      class="mb-16 md:mb-24 w-full aspect-3/2 md:aspect-video overflow-hidden bg-(--background-1)"
    >
      <img
        src="/images/studio-02.jpg"
        alt="Visual Label — wnętrze studia"
        loading="lazy"
        class="w-full h-full object-cover"
      />
    </div>

    <section class="grid gap-8 md:grid-cols-2 md:gap-x-4 lg:gap-x-6 items-start">
      <div class="w-full aspect-3/4 overflow-hidden bg-(--background-1)">
        <img
          src="/images/studio-01.jpg"
          alt="Marcin — założyciel Visual Label"
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>
      <div>
        <h2 class="h3">Marcin</h2>
        <p class="mt-1 mb-6 text-sm text-(--muted)">Założyciel i główny projektant</p>
        <p class="mb-4">
          Visual Label to studio jednoosobowe — bez pośredników i account
          managerów. Od pierwszego briefu po pliki produkcyjne pracujesz
          bezpośrednio z projektantem odpowiedzialnym za każdy element projektu.
        </p>
        <p>
          Projektuję identyfikacje wizualne i strony internetowe — od logo i
          materiałów drukowanych po wdrożenia online. Połączenie projektowania
          graficznego z kodem sprawia, że to, co dobrze wygląda na papierze,
          działa też w przeglądarce.
        </p>
      </div>
    </section>

    <section class="mt-16 md:mt-24 border-t border-(--border)">
      <h2 class="h3 mt-1 mb-6">Usługi</h2>
      <ul class="grid gap-x-2 md:gap-x-4 lg:gap-x-6 gap-y-8 md:grid-cols-2">
        <li class="pt-4 border-t border-(--border)">
          <p class="mb-2 text-xs font-mono uppercase text-(--muted)">01</p>
          <h3 class="h4 mb-1">Logo i identyfikacja</h3>
          <p class="text-sm text-(--muted)">
            Logo i systemy identyfikacji wizualnej, które skalują się od
            wizytówki do bilbordu.
          </p>
        </li>
        <li class="pt-4 border-t border-(--border)">
          <p class="mb-2 text-xs font-mono uppercase text-(--muted)">02</p>
          <h3 class="h4 mb-1">Strony internetowe</h3>
          <p class="text-sm text-(--muted)">
            Szybkie, dostępne strony projektowane i kodowane w jednym miejscu —
            projekt i kod pod jednym dachem.
          </p>
        </li>
        <li class="pt-4 border-t border-(--border)">
          <p class="mb-2 text-xs font-mono uppercase text-(--muted)">03</p>
          <h3 class="h4 mb-1">Sklepy internetowe</h3>
          <p class="text-sm text-(--muted)">
            Sklepy nastawione na konwersję, spójne z Twoją marką.
          </p>
        </li>
        <li class="pt-4 border-t border-(--border)">
          <p class="mb-2 text-xs font-mono uppercase text-(--muted)">04</p>
          <h3 class="h4 mb-1">Projekt druku</h3>
          <p class="text-sm text-(--muted)">
            Wizytówki, katalogi i plakaty, które przenoszą identyfikację do
            świata fizycznego.
          </p>
        </li>
      </ul>
    </section>

    <div
      class="mt-16 md:mt-24 w-full aspect-3/2 md:aspect-video overflow-hidden bg-(--background-1)"
    >
      <img
        src="/images/studio-03.jpg"
        alt="Wydrukowane materiały identyfikacji wizualnej na biurku"
        loading="lazy"
        class="w-full h-full object-cover"
      />
    </div>

    <section class="mt-16 md:mt-24 mb-12">
      <h2 class="h3 mb-2">Masz projekt?</h2>
      <p class="mb-6 text-(--muted)">
        Napisz, czego potrzebujesz — odpowiadam w ciągu dwóch dni roboczych.
      </p>
      <Button href={getRoute(locale, "contact")}>Rozpocznij projekt</Button>
    </section>

    <a class="link" href="/pl/wytyczne-identyfikacji"
      >Wytyczne identyfikacji wizualnej</a
    >
  </div>
</BaseLayout>