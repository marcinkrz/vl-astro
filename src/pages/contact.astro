---
import { type Locale } from "@/i18n/messages";
import { getRoute } from "@/i18n/routes";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/_ui/Button.astro";
import ContactForm from "@/components/ContactForm.astro";

const locale = (Astro.currentLocale === "pl" ? "pl" : "en") as Locale;
---

<BaseLayout title="Contact" description="Get in touch with us.">
  <div class="container-full mt-24 mb-24 md:grid md:grid-cols-3 lg:grid-cols-4">
    <div class="col-span-2">
      <h1 class="display mb-4 reveal">Contact</h1>
      <p class="lead mb-12 text-(--muted-1) reveal">Please feel free to get in touch.</p>
      <Button
        variant="outline"
        size="large"
        class="mb-6 flex reveal"
        href={getRoute(locale, "brief")}
      >
        Request a quote
      </Button>
      <p class="text-(--muted-1) reveal">
        Fill in&nbsp;
        <Button
          id="modal-contact-form"
          variant="link"
          class="h-auto leading-inherit">
          form
        </Button> or write directly to&nbsp;
        <Button
          variant="link"
          href="mailto:info@visuallabel.com"
          class="h-auto leading-inherit">info@visuallabel.com</Button
        >.
      </p>
      <div class="reveal">
        <ContactForm locale={locale} client:load />
      </div>
    </div>
  </div>
</BaseLayout>
