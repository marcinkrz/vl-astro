---
import "@/styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import CookieManager from "@/components/CookieManager/CookieManager.astro";
import Button from "@/components/_ui/Button.astro";
import LangRedirect from "@/components/LangRedirect.astro";
import Input from "@/components/_ui/Input.astro";
import Footer from "@/components/Footer.astro";

import { getT, type Locale } from "@/i18n/messages";
const locale = (Astro.currentLocale === "pl" ? "pl" : "en") as Locale;
const t = getT(locale);
const pageTitle = "Login";

export const prerender = false;

let passwordError = false;

if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();
  const password = data.get("password");

  if (password === import.meta.env.SITE_PASSWORD) {
    Astro.cookies.set("site_auth", "true", {
      path: "/",
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: "lax",
    });
    return Astro.redirect("/");
  }

  passwordError = true;
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <LangRedirect />
    <ClientRouter />
    <Font cssVariable="--font-copy" />
  </head>
  <body>
    <main class="container">
      <div class="h-[calc(100svh-66px)] flex items-center justify-center">
        <form method="POST" class="space-y-3">
          <label class="relative block">
            <Input
              type="password"
              id="password"
              name="password"
              placeholder=" "
              autocomplete="current-password"
              required
              class={passwordError ? "peer field-invalid" : "peer"}
              aria-invalid={passwordError ? "true" : undefined}
              aria-describedby={passwordError ? "password-error" : undefined}
              showPasswordLabel={t("login.showPassword")}
              hidePasswordLabel={t("login.hidePassword")}
            >
              <span
                class={`
                pointer-events-none
                absolute left-2 top-5 -translate-y-1/2
                px-[0.5ch]
                bg-(--background)
                text-(--muted)
                transition-all duration-150
                peer-focus:top-0
                peer-focus:-translate-y-1/2
                peer-focus:text-sm
                peer-not-placeholder-shown:top-0
                peer-not-placeholder-shown:-translate-y-1/2
                peer-not-placeholder-shown:text-sm
              `}
              >
                Password
              </span>
            </Input>
          </label>
          {
            passwordError && (
              <p id="password-error" role="alert" class="text-sm text-(--danger-text)">
                {t("login.wrongPassword")}
              </p>
            )
          }
          <Button
            class="w-full"
            type="submit"
            variant="ghost"
            size="large"
          >Login</Button>
        </form>
      </div>
    </main>
    <Footer />
    <CookieManager />
    <script>
      // Autofokus na polu hasła — także po nawigacji klientowej (ClientRouter).
      // iOS/Android: programowy focus nie otwiera klawiatury (Safari wymaga
      // gestu użytkownika) — pomijamy focus zamiast zostawiać pole ze stanem
      // „skupione bez klawiatury”; klawiatura pojawi się przy pierwszym tapnięciu.
      const focusPassword = () => {
        if (window.matchMedia("(pointer: coarse)").matches) return;
        document.getElementById("password")?.focus({ preventScroll: true });
      };
      focusPassword();
      document.addEventListener("astro:page-load", focusPassword);
    </script>
  </body>
</html>